+using Ninject;
+using NUnit.Framework;
+using System.Text.Json;
+using static GeoGen.Core.ConfigurationObjectType;
+using static GeoGen.Core.PredefinedConstructions;
+
+namespace GeoGen.ConfigurationGenerator.Tests;
+
+[TestFixture]
+public class SoftSearchTest
+{
+    private sealed class CountingConstructor : IGeometryConstructor
+    {
+        private readonly IGeometryConstructor _inner;
+        public int Clones, Roots;
+        public CountingConstructor(IGeometryConstructor inner) => _inner = inner;
+        public (PicturesOfConfiguration pictures, ConstructionData data) Construct(Configuration c, int count, Func<IAnalyticObject[]> draw)
+        {
+            Roots++; var i = 0;
+            return _inner.Construct(c, count, () => { var j = i++; return new IAnalyticObject[] {
+                new GeoGen.AnalyticGeometry.Point(0,0),new GeoGen.AnalyticGeometry.Point(1,0),
+                new GeoGen.AnalyticGeometry.Point(.28+.13*j,.8+.17*j) }; });
+        }
+        public (PicturesOfConfiguration pictures, ConstructionData data) ConstructByCloning(PicturesOfConfiguration p, Configuration c)
+        { Clones++; return _inner.ConstructByCloning(p,c); }
+        public ConstructionData Construct(Pictures p, ConstructedConfigurationObject obj, bool add) => _inner.Construct(p,obj,add);
+        public IAnalyticObject Construct(Picture p, ConstructedConfigurationObject obj, bool add) => _inner.Construct(p,obj,add);
+    }
+    private sealed class CountingFinder : ITheoremFinder
+    {
+        private readonly ITheoremFinder _inner;
+        public int Initial, Updates;
+        public CountingFinder(ITheoremFinder inner) => _inner=inner;
+        public TheoremMap FindAllTheorems(ContextualPicture p) { Initial++;return _inner.FindAllTheorems(p); }
+        public TheoremMap FindNewTheorems(ContextualPicture p,TheoremMap old,out Theorem[] invalid)
+        { Updates++;return _inner.FindNewTheorems(p,old,out invalid); }
+    }
+    private static (GeoGen.ProblemGenerator.ProblemGenerator generator, CountingConstructor constructor, CountingFinder finder, IKernel kernel) Services()
+    {
+        var kernel=NinjectUtilities.CreateKernel();kernel.AddConstructor();
+        kernel.AddTheoremFinder(new TheoremFindingSettings(new[]{TheoremType.CollinearPoints,TheoremType.ConcyclicPoints,
+            TheoremType.PerpendicularLines,TheoremType.ParallelLines,TheoremType.EqualLineSegments},null,null));
+        kernel.AddConfigurationGenerator(new GenerationSettings(ConfigurationFilterType.MemoryEfficient));
+        var constructor=new CountingConstructor(kernel.Get<IGeometryConstructor>());var finder=new CountingFinder(kernel.Get<ITheoremFinder>());
+        var generator=new GeoGen.ProblemGenerator.ProblemGenerator(new ProblemGeneratorSettings(3),kernel.Get<IConfigurationGenerator>(),constructor,finder,new EmptyGeometryFailureTracer());
+        return (generator,constructor,finder,kernel);

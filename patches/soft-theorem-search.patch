+    private static ProblemGeneratorInput Input(SymmetryGenerationMode mode,int iterations=3,bool midpointOnly=false,bool hidden=false)
+    {
+        var a=new LooseConfigurationObject(Point);var b=new LooseConfigurationObject(Point);var c=new LooseConfigurationObject(Point);
+        var config=Configuration.DeriveFromObjects(LooseObjectLayout.Triangle,a,b,c);
+        return new ProblemGeneratorInput(config,(midpointOnly?new Construction[]{Midpoint}:new Construction[]{Midpoint,ComposedConstructions.Orthocenter}).ToReadOnlyHashSet(),iterations,
+            new Dictionary<ConfigurationObjectType,int>{{Point,iterations},{Line,0},{Circle,0}},mode,hidden?new[]{a}:Array.Empty<ConfigurationObject>());
+    }
+    private static string Snapshot(ProblemGeneratorOutput output)
+    {
+        var f=new OutputFormatter(output.Configuration.AllObjects);
+        return f.FormatConfiguration(output.Configuration)+"\n"+string.Join("\n",output.OldTheorems.AllObjects.Concat(output.NewTheorems.AllObjects).Select(f.FormatTheorem).OrderBy(x=>x));
+    }

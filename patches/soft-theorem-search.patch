diff --git a/Source/Library/GeoGen.ProblemGenerator/SoftTheoremBias.cs b/Source/Library/GeoGen.ProblemGenerator/SoftTheoremBias.cs
new file mode 100644
--- /dev/null
+++ b/Source/Library/GeoGen.ProblemGenerator/SoftTheoremBias.cs
@@ -0,0 +1,187 @@
+using System.Diagnostics;
+using System.Text.Json;
+using GeoGen.ConfigurationGenerator;
+using GeoGen.Core;
+
+namespace GeoGen.ProblemGenerator;
+
+/// <summary>Optional rejection inside the ORIGINAL configuration verifier. No sibling batching or ranking.</summary>
+public sealed class SoftTheoremBias : IDisposable
+{
+    public sealed record Checkpoint(int Points, int Stage);
+    public sealed record Observation(Checkpoint Next, int Depth, int NewPoints, double TheoremsPerPoint,
+        double NewPointTheorems, bool InsideTargets, bool Final = false);
+    private sealed class Histogram
+    {
+        public readonly Dictionary<double, long> Values = new();
+        public void Add(double value) => Values[value] = Values.GetValueOrDefault(value) + 1;
+        public object Export() => Values.OrderBy(x => x.Key).Select(x => new[] { x.Key, (double)x.Value }).ToArray();
+    }
+    private sealed class StageReference
+    {
+        public long Samples;
+        public readonly Histogram Density = new(), NewDegree = new();
+        public readonly Dictionary<string, long> FirstOperations = new();
+    }
+    private readonly TheoremSearchSettings _settings;
+    private readonly ProblemGeneratorInput _input;
+    private readonly Stopwatch _clock = Stopwatch.StartNew();
+    private readonly Random _random;
+    private readonly StreamWriter _trace;
+    private readonly Dictionary<int, StageReference> _reference = new();
+    private readonly StageReference _finalReference = new();
+    private bool _disposed;
+    private Observation _lastObservation;
+    public long Candidates { get; private set; }
+    public long OutsideReferenceStratum { get; private set; }
+    public long SymmetryPrunedBeforeDrawing { get; private set; }
+    public long DrawingAttempts { get; private set; }
+    public long InvalidDrawings { get; private set; }
+    public long FinderCalls { get; private set; }
+    public long MetricsEvaluated { get; private set; }
+    public long Checkpoints { get; private set; }
+    public long IncompleteSymmetryPreserved { get; private set; }
+    public long OutsideTargets { get; private set; }
+    public long RejectedByBias { get; private set; }
+    public long Outputs { get; private set; }
+    public double FinderMs { get; private set; }
+    public double MetricsMs { get; private set; }
+    public bool Active => _settings.KeepOutsideTargetsPercent < 100 && (_settings.Phases.Any(p => p.HasCountTargets) || _settings.Final?.HasCountTargets == true);
+    public bool NeedsMetrics => Active || _settings.CollectReference;
+    public bool ShouldStop => _clock.Elapsed.TotalSeconds >= _settings.Seconds || FinderCalls >= _settings.MaxEvaluated;
+
+    public SoftTheoremBias(TheoremSearchSettings settings, ProblemGeneratorInput input, int pictures)
+    {
+        settings.Validate(); _settings = settings; _input = input; _random = new Random(settings.Seed);
+        if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("GEOGEN_RELATION_WORKER")))
+            throw new ArgumentException("Cannot combine original soft search with Python sampling");
+        if (settings.TraceFile != null)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(settings.TraceFile))!);
+            _trace = new StreamWriter(settings.TraceFile) { AutoFlush = true };
+        }
+        Write(new { kind = "start", policy = "soft", originalGenerator = true,
+            symmetryMode = input.SymmetryGenerationMode.ToString(), pictures,
+            settings.KeepOutsideTargetsPercent, settings.CollectReference,
+            phases = settings.Phases, final = settings.Final, needsMetrics = NeedsMetrics });
+    }
+
+    public void BeforeCandidate()
+    {
+        if (ShouldStop) throw new SoftSearchDeadlineException();
+        Candidates++;
+    }
+    public bool AllowsRoot(GeneratedConfiguration configuration)
+    {
+        if (_settings.ReferenceRootConstruction == null || configuration.IterationIndex != 1 ||
+            configuration.LastConstructedObject.Construction.Name == _settings.ReferenceRootConstruction) return true;
+        OutsideReferenceStratum++; return false;
+    }
+    public void SymmetryPruned() => SymmetryPrunedBeforeDrawing++;
+    public void BeforeDrawing() => DrawingAttempts++;
+    public void InvalidDrawing() => InvalidDrawings++;
+    public void FoundTheorems(double elapsedMs) { FinderCalls++; FinderMs += elapsedMs; }
+    public void Output() => Outputs++;
+    public void Incomplete() => IncompleteSymmetryPreserved++;
+
+    public bool IsCheckpoint(GeneratedConfiguration configuration) => _input.SymmetryGenerationMode switch
+    {
+        SymmetryGenerationMode.GenerateBothSymmetricAndAsymmetric => true,
+        SymmetryGenerationMode.GenerateOnlySymmetric => configuration.IsSymmetric(),
+        SymmetryGenerationMode.GenerateOnlyFullySymmetric => configuration.IsFullySymmetric(),
+        _ => throw new ArgumentException("Unknown symmetry mode")
+    };
+
+    public Observation Observe(GeneratedConfiguration configuration, TheoremMap allTheorems, Checkpoint previous)
+    {
+        var began = Stopwatch.GetTimestamp();
+        var metrics = TheoremSearchMetrics.Measure(configuration, allTheorems.AllObjects, _settings);
+        var count = metrics.Points - previous.Points;
+        var newDegree = count == 0 ? 0 : metrics.Degrees.Skip(previous.Points).Average();
+        // These user-visible counts always mean raw weighted T/N, not the former T/N^p objective.
+        var density = metrics.TotalTheoremWeight / Math.Max(1, metrics.Points);
+        var stage = previous.Stage + 1;
+        var terminal = configuration.IterationIndex == _input.NumberOfIterations ||
+            _input.Constructions.All(c => configuration.ObjectMap.GetObjectsForKeys(c.OutputType).Count() -
+                _input.InitialConfiguration.ObjectMap.GetObjectsForKeys(c.OutputType).Count() >= _input.MaximalNumbersOfObjectsToAdd[c.OutputType]);
+        var phase = terminal && _settings.Final != null ? _settings.Final : _settings.Phase(stage);
+        var inside = (phase.TheoremsPerPoint?.Contains(density) ?? true) &&
+            (count == 0 || (phase.NewPointTheorems?.Contains(newDegree) ?? true));
+        MetricsEvaluated++; Checkpoints++; MetricsMs += Stopwatch.GetElapsedTime(began).TotalMilliseconds;
+        var observation = new Observation(new Checkpoint(metrics.Points, stage), configuration.IterationIndex,
+            count, density, newDegree, inside, terminal);
+        if (_settings.CollectReference)
+        {
+            if (!_reference.TryGetValue(stage, out var reference)) _reference[stage] = reference = new StageReference();
+            var operation = configuration.ConstructedObjects[_input.InitialConfiguration.ConstructedObjects.Count].Construction.Name;
+            void Add(StageReference sample)
+            {
+                sample.Samples++; sample.Density.Add(density);
+                if (count > 0) sample.NewDegree.Add(newDegree);
+                sample.FirstOperations[operation] = sample.FirstOperations.GetValueOrDefault(operation) + 1;
+            }
+            Add(reference);
+            if (terminal) Add(_finalReference);
+        }
+        _lastObservation = observation;
+        return observation;
+    }
+
+    public bool Keep(Observation observation)
+    {
+        if (observation.InsideTargets) return true;
+        OutsideTargets++;
+        if (!Active || _random.NextDouble() * 100 < _settings.KeepOutsideTargetsPercent) return true;
+        RejectedByBias++;
+        if (RejectedByBias <= 3 || RejectedByBias % _settings.LogEveryExpanded == 0)
+            Write(new { kind = "rejected", seconds = _clock.Elapsed.TotalSeconds, observation });
+        return false;
+    }
+
+    public IEnumerable<ProblemGeneratorOutput> Track(IEnumerable<ProblemGeneratorOutput> source)
+    {
+        using var enumerator = source.GetEnumerator();
+        try
+        {
+            while (!ShouldStop)
+            {
+                bool next;
+                try { next = enumerator.MoveNext(); }
+                catch (SoftSearchDeadlineException) { break; }
+                if (!next) break;
+                Output();
+                if (Outputs % _settings.LogEveryExpanded == 0)
+                    Write(new { kind = "progress", seconds = _clock.Elapsed.TotalSeconds, counters = Counters(), lastObservation = _lastObservation });
+                yield return enumerator.Current;
+            }
+        }
+        finally { Dispose(); }
+    }
+
+    private object Counters() => new { Candidates, OutsideReferenceStratum, SymmetryPrunedBeforeDrawing, DrawingAttempts, InvalidDrawings,
+        FinderCalls, FinderMs, MetricsEvaluated, MetricsMs, Checkpoints, IncompleteSymmetryPreserved,
+        OutsideTargets, RejectedByBias, Outputs };
+    private void Write(object record) => _trace?.WriteLine(JsonSerializer.Serialize(record, TheoremSearchSettings.JsonOptions));
+    public void Dispose()
+    {
+        if (_disposed) return; _disposed = true;
+        Write(new { kind = "finish", seconds = _clock.Elapsed.TotalSeconds, counters = Counters(),
+            originalGenerator = true, cpuMs = Process.GetCurrentProcess().TotalProcessorTime.TotalMilliseconds,
+            peakWorkingSet = Process.GetCurrentProcess().PeakWorkingSet64 });
+        _trace?.Dispose();
+        if (_settings.CollectReference && _settings.ReferenceFile != null)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(_settings.ReferenceFile))!);
+            var data = new { version = 1, unbiased = !Active, originalGenerator = true,
+                rootConstruction = _settings.ReferenceRootConstruction, symmetryMode = _input.SymmetryGenerationMode.ToString(), seconds = _clock.Elapsed.TotalSeconds,
+                counters = Counters(), final = new { samples = _finalReference.Samples,
+                    densityHistogram = _finalReference.Density.Export(), newPointHistogram = _finalReference.NewDegree.Export(),
+                    firstOperations = _finalReference.FirstOperations }, stages = _reference.OrderBy(x => x.Key).Select(x => new {
+                    stage = x.Key, samples = x.Value.Samples, densityHistogram = x.Value.Density.Export(),
+                    newPointHistogram = x.Value.NewDegree.Export(), firstOperations = x.Value.FirstOperations }) };
+            File.WriteAllText(_settings.ReferenceFile, JsonSerializer.Serialize(data, TheoremSearchSettings.JsonOptions));
+        }
+    }
+}
+
+internal sealed class SoftSearchDeadlineException : Exception { }

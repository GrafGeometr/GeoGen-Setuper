+using IAnalyticObject = GeoGen.AnalyticGeometry.IAnalyticObject;
+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.Infrastructure;
+using GeoGen.ProblemGenerator;
+using GeoGen.TheoremFinder;

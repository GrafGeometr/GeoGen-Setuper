+/// <summary>Ascending numerical metric: 0 is the fewest theorems, 1 the most.</summary>
+public sealed class RankInterval
+{
+    public double From { get; set; } = 0;
+    public double To { get; set; } = 1;
+    public string Metric { get; set; } = "theoremsPerPoint";
+    public int MinimumNewTheorems { get; set; } = 0;
+    public bool IsIdentity => From == 0 && To == 1 && MinimumNewTheorems == 0;
+    public void Validate()
+    {
+        if (!double.IsFinite(From) || !double.IsFinite(To) || From < 0 || To > 1 || From >= To ||
+            MinimumNewTheorems < 0 || (Metric != "theoremsPerPoint" && Metric != "newPointTheorems"))
+            throw new ArgumentException("Rank interval requires 0 <= from < to <= 1 and a known metric");
+    }
+    public (int start, int end) Indices(int count) => ((int)Math.Floor(From * count), Math.Min(count, (int)Math.Ceiling(To * count)));
+}

diff --git a/Source/Library/GeoGen.ProblemGenerator/ExactRankSelector.cs b/Source/Library/GeoGen.ProblemGenerator/ExactRankSelector.cs
new file mode 100644
--- /dev/null
+++ b/Source/Library/GeoGen.ProblemGenerator/ExactRankSelector.cs
@@ -0,0 +1,102 @@
+using System.Diagnostics;
+using GeoGen.ConfigurationGenerator;
+using GeoGen.Constructor;
+using GeoGen.Core;
+using GeoGen.TheoremFinder;
+
+namespace GeoGen.ProblemGenerator;
+
+/// <summary>Exact local rank among all canonical, symmetry-reachable, constructible siblings.
+/// Preview geometry is discarded; only definitions and scalar scores are kept.</summary>
+internal sealed class ExactRankSelector
+{
+    private readonly TheoremSearchSettings _settings;
+    private readonly ProblemGeneratorInput _input;
+    private readonly IGeometryConstructor _constructor;
+    private readonly ITheoremFinder _finder;
+    private readonly SoftTheoremBias _monitor;
+    private readonly int _lastDepth;
+    private readonly record struct Row(ConstructedConfigurationObject Object, double Score, int Index);
+
+    public ExactRankSelector(TheoremSearchSettings settings, ProblemGeneratorInput input,
+        IGeometryConstructor constructor, ITheoremFinder finder, SoftTheoremBias monitor)
+    {
+        _settings=settings;_input=input;_constructor=constructor;_finder=finder;_monitor=monitor;
+        var budget=input.Constructions.Select(c=>c.OutputType).Distinct().Sum(t=>(long)input.MaximalNumbersOfObjectsToAdd[t]);
+        _lastDepth=(int)Math.Min(input.NumberOfIterations,budget);
+    }
+    private RankInterval Window(int depth)
+    {
+        if(depth>=_lastDepth && _settings.FinalRankInterval!=null)return _settings.FinalRankInterval;
+        return _settings.RankIntervals.Length==0 ? null : _settings.RankIntervals[Math.Min(depth-1,_settings.RankIntervals.Length-1)];
+    }
+    public IEnumerable<GeneratedConfiguration> Select(GeneratedConfiguration parent,
+        IEnumerable<GeneratedConfiguration> siblings, PicturesOfConfiguration pictures,
+        ContextualPicture context, TheoremMap oldTheorems)
+    {
+        var window=Window(parent.IterationIndex+1);
+        // Do not enumerate or score the list at all in an unrestricted step.
+        if(window==null || window.IsIdentity)return siblings;
+        return SelectExact(parent,siblings,pictures,context,oldTheorems,window);
+    }
+    private IEnumerable<GeneratedConfiguration> SelectExact(GeneratedConfiguration parent,
+        IEnumerable<GeneratedConfiguration> siblings, PicturesOfConfiguration pictures,
+        ContextualPicture context, TheoremMap oldTheorems, RankInterval window)
+    {
+        var began=Stopwatch.GetTimestamp();var pool=new List<Row>();var selected=0;var complete=false;var reported=false;
+        double? minimum=null,maximum=null;
+        _monitor.BeginRankPool(parent.IterationIndex,window);
+        try
+        {
+            // No preview may touch the streaming verifier's DFS caches.
+            foreach(var candidate in siblings)
+            {
+                _monitor.BeforeRankCandidate();
+                if(!_monitor.AllowsRoot(candidate))continue;
+                if(!SymmetryReachability.CanComplete(candidate,_input))
+                { _monitor.RankSymmetryRejected();continue; }
+                double score;
+                try
+                {
+                    _monitor.RankBeforeDrawing();
+                    var (newPictures,data)=_constructor.ConstructByCloning(pictures,candidate);
+                    if(newPictures==null || data.InconstructibleObject!=null || data.Duplicates!=default)
+                    { _monitor.RankInvalid();continue; }
+                    var newContext=context.ConstructByCloning(newPictures);
+                    if(newContext==null){_monitor.RankInvalid();continue;}
+                    var added=_finder.FindNewTheorems(newContext,oldTheorems,out var invalid);
+                    _monitor.RankFound();
+                    if(window.MinimumNewTheorems>0 && added.AllObjects.Distinct().Take(window.MinimumNewTheorems).Count()<window.MinimumNewTheorems)
+                    { _monitor.RankBelowMinimum();continue; }
+                    var all=new TheoremMap(oldTheorems.AllObjects.Except(invalid).Concat(added.AllObjects));
+                    var metrics=TheoremSearchMetrics.Measure(candidate,all.AllObjects,_settings);
+                    _monitor.RankMeasured();
+                    score=window.Metric=="theoremsPerPoint" ? metrics.TotalTheoremWeight/Math.Max(1,metrics.Points) :
+                        candidate.LastConstructedObject.ObjectType==ConfigurationObjectType.Point ? metrics.NewPointDegree : 0;
+                }
+                catch(InconsistentPicturesException){_monitor.RankInvalid();continue;}
+                pool.Add(new Row(candidate.LastConstructedObject,score,pool.Count));
+            }
+            var sorted=pool.ToArray();
+            Array.Sort(sorted,(a,b)=>{var comparison=a.Score.CompareTo(b.Score);return comparison!=0?comparison:a.Index.CompareTo(b.Index);});
+            var (first,end)=window.Indices(sorted.Length);var keep=new bool[pool.Count];
+            for(var i=first;i<end;i++){keep[sorted[i].Index]=true;selected++;}
+            if(sorted.Length>0){minimum=sorted[0].Score;maximum=sorted[^1].Score;}
+            complete=true;
+            _monitor.EndRankPool(parent.IterationIndex,window,pool.Count,selected,
+                Stopwatch.GetElapsedTime(began).TotalMilliseconds,true,minimum,maximum);
+            reported=true;
+            // Keep only selected definitions alive while DFS descends; drop the preview arrays.
+            var chosen=pool.Where(row=>keep[row.Index]).Select(row=>row.Object).ToArray();
+            pool.Clear();pool=null;sorted=null;keep=null;
+            // Original sibling order is retained inside the allowed rank interval.
+            foreach(var obj in chosen)
+                yield return new GeneratedConfiguration(parent,obj,parent.IterationIndex+1);
+        }
+        finally
+        {
+            if(!reported)_monitor.EndRankPool(parent.IterationIndex,window,pool?.Count??0,selected,
+                Stopwatch.GetElapsedTime(began).TotalMilliseconds,complete,minimum,maximum);
+        }
+    }
+}
diff --git a/Source/Library/GeoGen.ProblemGenerator/SymmetryReachability.cs b/Source/Library/GeoGen.ProblemGenerator/SymmetryReachability.cs
new file mode 100644
--- /dev/null
+++ b/Source/Library/GeoGen.ProblemGenerator/SymmetryReachability.cs
@@ -0,0 +1,29 @@
+using GeoGen.ConfigurationGenerator;
+using GeoGen.Core;
+using GeoGen.Utilities;
+
+namespace GeoGen.ProblemGenerator;
+
+/// <summary>Original pre-drawing symmetry check, shared by streaming verification and exact ranking.</summary>
+internal static class SymmetryReachability
+{
+    public static bool CanComplete(GeneratedConfiguration configuration, ProblemGeneratorInput input)
+    {
+        if (input.SymmetryGenerationMode == SymmetryGenerationMode.GenerateBothSymmetricAndAsymmetric) return true;
+        var options = input.SymmetryGenerationMode switch
+        {
+            SymmetryGenerationMode.GenerateOnlySymmetric => configuration.GetObjectsThatWouldMakeThisConfigurationSymmetric(),
+            SymmetryGenerationMode.GenerateOnlyFullySymmetric => configuration.GetObjectsThatWouldMakeThisConfigurationFullySymmetric().ToEnumerable(),
+            _ => throw new GeoGenException($"Unhandled symmetry mode: {input.SymmetryGenerationMode}")
+        };
+        return options.Any(objects =>
+        {
+            if (objects.Any(o => o.PassedArguments.FlattenedList.Any(input.HiddenPoints.Contains)) ||
+                configuration.IterationIndex + objects.Count > input.NumberOfIterations ||
+                objects.Any(o => !input.Constructions.Contains(o.Construction))) return false;
+            return objects.GroupBy(o => o.ObjectType).All(group =>
+                group.Count() + configuration.ObjectMap.GetObjectsForKeys(group.Key).Count() -
+                input.InitialConfiguration.ObjectMap.GetObjectsForKeys(group.Key).Count() <= input.MaximalNumbersOfObjectsToAdd[group.Key]);
+        });
+    }
+}

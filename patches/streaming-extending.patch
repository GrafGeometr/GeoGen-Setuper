+-- Machine-readable single-file mode never renames its input. Force the Boolean
+-- inside the timeout; runRand alone can return a thunk whose work happens later.
+checkOne :: FilePath -> Int -> IO ()
+checkOne file milliseconds = do
+    outcome <- try (timeout (milliseconds * 1000) $ do
+        contents <- readFile file
+        _ <- evaluate (length contents)
+        case parseTheorem file $ unlines . fmap tail . filter ("!" `isPrefixOf`) . lines $ contents of
+            Left err -> ioError (userError (show err))
+            Right (cs, cc) -> runRand (check10 cs cc) >>= evaluate
+        ) :: IO (Either SomeException (Maybe Bool))
+    let (status, message) = case outcome of
+            Left err -> ("error", displayException err)
+            Right Nothing -> ("timeout", "Check exceeded time limit")
+            Right (Just True) -> ("accepted", "")
+            Right (Just False) -> ("rejected", "Construction failed the extending filter")
+    putStrLn $ "{\"status\":" <> jsonString status <> ",\"message\":" <> jsonString message <> "}"
+
+jsonString :: String -> String
+jsonString text = "\"" <> concatMap escape text <> "\""
+    where
+        escape '\"' = "\\\""
+        escape '\\' = "\\\\"
+        escape c | ord c < 32 = let hex = showHex (ord c) "" in "\\u" <> replicate (4 - length hex) '0' <> hex
+                 | otherwise = [c]

@@ -0,0 +1,171 @@
+using FluentAssertions;
+using GeoGen.Core;
+using GeoGen.Infrastructure;
+using GeoGen.ProblemGenerator;
+using GeoGen.ProblemGenerator.InputProvider;
+using GeoGen.Utilities;
+using Ninject;
+using NUnit.Framework;
+using static GeoGen.Core.ConfigurationObjectType;
+using static GeoGen.Core.LooseObjectLayout;
+using static GeoGen.Core.PredefinedConstructions;
+
+namespace GeoGen.ConfigurationGenerator.Tests
+{
+    [TestFixture]
+    public class HiddenPointsTest
+    {
+        private static IConfigurationGenerator Generator(ConfigurationFilterType type)
+            => NinjectUtilities.CreateKernel().AddConfigurationGenerator(new GenerationSettings(type)).Get<IConfigurationGenerator>();
+
+        private static ConfigurationGeneratorInput Input(Configuration configuration, IEnumerable<ConfigurationObject> hidden,
+            int iterations = 1, IEnumerable<Construction> constructions = null, int maxPoints = 3)
+            => new ConfigurationGeneratorInput(configuration,
+                (constructions ?? new[] { Midpoint }).ToReadOnlyHashSet(), iterations,
+                new Dictionary<ConfigurationObjectType, int> { { Point, maxPoints }, { Line, 1 }, { Circle, 1 } },
+                _ => true, hidden);
+
+        [TestCase(ConfigurationFilterType.Fast)]
+        [TestCase(ConfigurationFilterType.MemoryEfficient)]
+        [TestCase(ConfigurationFilterType.Simple)]
+        public void Hidden_vertex_does_not_remove_the_only_reachable_midpoint(ConfigurationFilterType type)
+        {
+            var a = new LooseConfigurationObject(Point);
+            var b = new LooseConfigurationObject(Point);
+            var c = new LooseConfigurationObject(Point);
+            var configuration = Configuration.DeriveFromObjects(Triangle, a, b, c);
+            var outputs = Generator(type).Generate(Input(configuration, new[] { a })).ToArray();
+            outputs.Should().ContainSingle();
+            outputs[0].ConstructedObjects.Should().Contain(new ConstructedConfigurationObject(Midpoint, b, c));
+            outputs[0].AllObjects.Should().Contain(a);
+        }
+
+        [TestCase(ConfigurationFilterType.Fast)]
+        [TestCase(ConfigurationFilterType.MemoryEfficient)]
+        [TestCase(ConfigurationFilterType.Simple)]
+        public void All_hidden_vertices_leave_no_arguments_for_any_construction(ConfigurationFilterType type)
+        {
+            var a = new LooseConfigurationObject(Point);
+            var b = new LooseConfigurationObject(Point);
+            var c = new LooseConfigurationObject(Point);
+            var configuration = Configuration.DeriveFromObjects(Triangle, a, b, c);
+            Generator(type).Generate(Input(configuration, new[] { a, b, c },
+                constructions: new[] { Midpoint, LineFromPoints, Circumcircle })).Should().BeEmpty();
+        }
+
+        [TestCase(ConfigurationFilterType.Fast, false)]
+        [TestCase(ConfigurationFilterType.MemoryEfficient, false)]
+        [TestCase(ConfigurationFilterType.Fast, true)]
+        [TestCase(ConfigurationFilterType.MemoryEfficient, true)]
+        public void Restricted_symmetry_filters_preserve_all_reachable_classes(ConfigurationFilterType type, bool hideConstructed)
+        {
+            var a = new LooseConfigurationObject(Point);
+            var b = new LooseConfigurationObject(Point);
+            var c = new LooseConfigurationObject(Point);
+            var d = new ConstructedConfigurationObject(Midpoint, a, b);
+            var configuration = Configuration.DeriveFromObjects(Triangle, a, b, c, d);
+            var hidden = hideConstructed ? new ConfigurationObject[] { d } : new ConfigurationObject[] { a };
+            var input = Input(configuration, hidden, iterations: 3);
+            var expected = Generator(ConfigurationFilterType.Simple).Generate(input).ToArray();
+            var actual = Generator(type).Generate(input).ToArray();
+            var mappings = configuration.LooseObjectsHolder.GetIsomorphicMappings()
+                .Where(m => hidden.All(h => hidden.Contains(h.Remap(m))))
+                .Where(m => configuration.ConstructedObjects.All(o => configuration.ConstructedObjectsSet.Contains(o.Remap(m))))
+                .ToArray();
+            bool Equivalent(Configuration left, Configuration right) => mappings.Any(m =>
+                left.ConstructedObjects.Select(o => o.Remap(m)).ToHashSet().SetEquals(right.ConstructedObjects));
+            foreach (var generated in actual)
+                generated.ConstructedObjects.Except(configuration.ConstructedObjects)
+                    .SelectMany(o => o.PassedArguments.FlattenedList).Should().NotContain(hidden);
+            foreach (var generated in expected)
+                actual.Any(candidate => Equivalent(candidate, generated)).Should().BeTrue("every reachable equivalence class must survive");
+            for (var i = 0; i < actual.Length; i++)
+                for (var j = i + 1; j < actual.Length; j++)
+                    Equivalent(actual[i], actual[j]).Should().BeFalse("equivalent configurations must not be emitted twice");
+        }
+
+        [Test]
+        public void Visible_initial_objects_built_from_hidden_points_remain_usable()
+        {
+            var a = new LooseConfigurationObject(Point);
+            var b = new LooseConfigurationObject(Point);
+            var c = new LooseConfigurationObject(Point);
+            var d = new ConstructedConfigurationObject(Midpoint, a, b);
+            var configuration = Configuration.DeriveFromObjects(Triangle, a, b, c, d);
+            var outputs = Generator(ConfigurationFilterType.MemoryEfficient).Generate(Input(configuration, new[] { a })).ToArray();
+            outputs.SelectMany(o => o.ConstructedObjects).Should().Contain(new ConstructedConfigurationObject(Midpoint, c, d));
+            Generator(ConfigurationFilterType.MemoryEfficient).Generate(Input(configuration, new[] { a }, maxPoints: 0)).Should().BeEmpty();
+        }
+
+        [Test]
+        public void Api_rejects_nonpoints_and_objects_outside_initial_configuration()
+        {
+            var a = new LooseConfigurationObject(Point);
+            var b = new LooseConfigurationObject(Point);
+            var c = new LooseConfigurationObject(Point);
+            var line = new ConstructedConfigurationObject(LineFromPoints, a, b);
+            var configuration = Configuration.DeriveFromObjects(Triangle, a, b, c, line);
+            foreach (var hidden in new ConfigurationObject[] { line, new LooseConfigurationObject(Point) })
+            {
+                Action invalid = () => Input(configuration, new[] { hidden });
+                invalid.Should().Throw<ArgumentException>();
+                Action invalidProblem = () => new ProblemGeneratorInput(configuration, new Construction[] { Midpoint }.ToReadOnlyHashSet(),
+                    1, new Dictionary<ConfigurationObjectType, int>(), SymmetryGenerationMode.GenerateBothSymmetricAndAsymmetric, new[] { hidden });
+                invalidProblem.Should().Throw<ArgumentException>();
+            }
+        }
+
+        private string _directory;
+        [SetUp]
+        public void SetUp() => _directory = Directory.CreateDirectory(Path.Combine(Path.GetTempPath(), "geogen-hidden-" + Guid.NewGuid())).FullName;
+        [TearDown]
+        public void TearDown() => Directory.Delete(_directory, recursive: true);
+
+        private async Task<LoadedProblemGeneratorInput> Parse(string metadata)
+        {
+            var path = Path.Combine(_directory, "input_hidden.txt");
+            await File.WriteAllTextAsync(path, $@"# Hidden metadata does not belong to the geometry parser
+Constructions:
+ Midpoint
+Initial configuration:
+ Triangle: A, B, C
+ D = Midpoint(A, B)
+ l = LineFromPoints(A, B)
+{metadata}
+Iterations: 1
+MaximalPoints: 1
+MaximalLines: 0
+MaximalCircles: 0
+SymmetryGenerationMode: GenerateBothSymmetricAndAsymmetric
+".Replace("\n", "\r\n"));
+            var provider = new ProblemGeneratorInputProvider(new ProblemGeneratorInputProviderSettings(_directory, "input", "txt"));
+            return (await provider.GetProblemGeneratorInputsAsync()).Single();
+        }
+
+        [TestCase("")]
+        [TestCase("HiddenPoints:")]
+        public async Task Old_inputs_and_empty_hidden_list_keep_existing_behavior(string metadata)
+            => (await Parse(metadata)).HiddenPoints.Should().BeEmpty();
+
+        [Test]
+        public async Task Hidden_names_are_resolved_and_propagated_to_loaded_input()
+        {
+            var input = await Parse("HiddenPoints: A, D");
+            input.HiddenPoints.Should().HaveCount(2);
+            input.HiddenPoints.Should().Contain(input.InitialConfiguration.LooseObjectsHolder.LooseObjects[0]);
+            input.HiddenPoints.Should().Contain(input.InitialConfiguration.ConstructedObjects[0]);
+        }
+
+        [TestCase("HiddenPoints: Missing", "Unknown hidden point")]
+        [TestCase("HiddenPoints: l", "points only")]
+        [TestCase("HiddenPoints: A, A", "more than once")]
+        [TestCase("HiddenPoints: A,", "Unknown hidden point")]
+        [TestCase("HiddenPoints: A\nHiddenPoints: B", "only be specified once")]
+        public async Task Invalid_metadata_is_rejected_with_a_useful_error(string metadata, string message)
+        {
+            Func<Task> parse = async () => await Parse(metadata);
+            var failure = await parse.Should().ThrowAsync<ProblemGeneratorInputProviderException>();
+            failure.Which.InnerException.Message.Should().Contain(message);
+        }
+    }
+}

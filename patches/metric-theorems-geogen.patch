@@ -0,0 +1,24 @@
+using GeoGen.AnalyticGeometry;
+using GeoGen.Core;
+namespace GeoGen.Constructor;
+public static class MetricRelations
+{
+    public const double Tolerance=1e-8;
+    public static double Factor(TheoremType type)=>type switch {
+        TheoremType.LengthRatio2=>4, TheoremType.LengthRatio3=>9, TheoremType.SquaredLengthRatio2=>2,
+        _=>throw new ArgumentException("Not a fixed ratio") };
+    public static double SquaredDistance(Point a,Point b)=> (a.X-b.X)*(a.X-b.X)+(a.Y-b.Y)*(a.Y-b.Y);
+    public static bool Ratio(double a,double b,double factor)=>a>0 && b>0 && double.IsFinite(a+b) &&
+        Math.Abs(Math.Max(a,b)-factor*Math.Min(a,b))<=Tolerance*Math.Max(a,b);
+    public static (double x,double y) DirectionAngle(Line a,Line b)
+    {
+        var dot=a.A*b.A+a.B*b.B;var cross=a.A*b.B-a.B*b.A;
+        var norm=dot*dot+cross*cross;
+        return norm>0 ? ((dot*dot-cross*cross)/norm,2*dot*cross/norm) : (double.NaN,double.NaN);
+    }
+    public static bool Angles(Line a,Line b,Line c,Line d)
+    {
+        var u=DirectionAngle(a,b);var v=DirectionAngle(c,d);
+        return double.IsFinite(u.x+u.y+v.x+v.y) && Math.Abs(u.x-v.x)<=Tolerance && Math.Abs(u.y-v.y)<=Tolerance;
+    }
+}

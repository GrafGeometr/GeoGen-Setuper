diff --git a/Source/Library/GeoGen.TheoremFinder/Finders/IndexedMetricTheoremFinders.cs b/Source/Library/GeoGen.TheoremFinder/Finders/IndexedMetricTheoremFinders.cs
new file mode 100644
--- /dev/null
+++ b/Source/Library/GeoGen.TheoremFinder/Finders/IndexedMetricTheoremFinders.cs
@@ -0,0 +1,111 @@
+using GeoGen.AnalyticGeometry;
+using GeoGen.Constructor;
+using GeoGen.Core;
+
+namespace GeoGen.TheoremFinder;
+
+public abstract class FixedLengthRatioTheoremFinder : TheoremFinderBase
+{
+    private sealed record Segment(PointObject A,PointObject B,double[] Values,bool New);
+    public override bool ValidateOldTheorem(ContextualPicture picture,Theorem theorem)=>true;
+    public override IEnumerable<Theorem> FindAllTheorems(ContextualPicture picture)=>Find(picture,false).Distinct();
+    public override IEnumerable<Theorem> FindNewTheorems(ContextualPicture picture)=>Find(picture,true).Distinct();
+    private IEnumerable<Theorem> Find(ContextualPicture context,bool incremental)
+    {
+        var points=context.AllPoints.ToArray();var pictures=context.Pictures.ToArray();var added=context.NewPoints.ToHashSet();
+        var index=new Dictionary<long,List<Segment>>();var factor=MetricRelations.Factor(Type);
+        const double cell=1e-7;
+        for(var i=0;i<points.Length;i++)for(var j=0;j<i;j++)
+        {
+            var values=new double[pictures.Length];
+            for(var p=0;p<pictures.Length;p++)values[p]=MetricRelations.SquaredDistance(
+                (Point)context.GetAnalyticObject(points[i],pictures[p]),(Point)context.GetAnalyticObject(points[j],pictures[p]));
+            if(values.Any(v=>v<=0 || !double.IsFinite(v)))continue;
+            var row=new Segment(points[i],points[j],values,added.Contains(points[i])||added.Contains(points[j]));
+            // Relative scale is indexed logarithmically; adjacent cells prevent boundary losses.
+            foreach(var target in new[]{values[0]*factor,values[0]/factor})
+            {
+                if(target<=0 || !double.IsFinite(target))continue;
+                var key=(long)Math.Floor(Math.Log(target)/cell);
+                for(var delta=-1;delta<=1;delta++)if(index.TryGetValue(key+delta,out var bucket))foreach(var old in bucket)
+                {
+                    if(incremental && !row.New && !old.New)continue;
+                    if(!Enumerable.Range(0,values.Length).All(p=>MetricRelations.Ratio(values[p],old.Values[p],factor)))continue;
+                    yield return new Theorem(Type,new TheoremObject[]{
+                        new LineSegmentTheoremObject(row.A.ConfigurationObject,row.B.ConfigurationObject),
+                        new LineSegmentTheoremObject(old.A.ConfigurationObject,old.B.ConfigurationObject)});
+                }
+            }
+            var own=(long)Math.Floor(Math.Log(values[0])/cell);
+            if(!index.TryGetValue(own,out var list))index[own]=list=new();list.Add(row);
+        }
+    }
+}
+public sealed class LengthRatio2TheoremFinder : FixedLengthRatioTheoremFinder { }
+public sealed class LengthRatio3TheoremFinder : FixedLengthRatioTheoremFinder { }
+public sealed class SquaredLengthRatio2TheoremFinder : FixedLengthRatioTheoremFinder { }
+
+public sealed class EqualAnglesTheoremFinder : TheoremFinderBase
+{
+    private sealed record Entry(LineObject First,LineObject Second,(double x,double y)[] Values,bool New);
+    public override bool ValidateOldTheorem(ContextualPicture picture,Theorem theorem)=>true;
+    public override IEnumerable<Theorem> FindAllTheorems(ContextualPicture picture)=>Find(picture,false).Distinct();
+    public override IEnumerable<Theorem> FindNewTheorems(ContextualPicture picture)=>Find(picture,true).Distinct();
+    private static LineTheoremObject Definition(LineObject line)
+    {
+        if(line.ConfigurationObject!=null)return new LineTheoremObject(line.ConfigurationObject);
+        var points=line.Points.Take(2).Select(p=>p.ConfigurationObject).ToArray();
+        return new LineTheoremObject(points[0],points[1]);
+    }
+    private IEnumerable<Theorem> Find(ContextualPicture context,bool incremental)
+    {
+        var lines=context.AllLines.ToArray();var pictures=context.Pictures.ToArray();var added=context.NewLines.ToHashSet();
+        var index=new Dictionary<long,List<Entry>>();const double cell=1e-7;
+        var analytic=lines.ToDictionary(line=>line,line=>pictures.Select(p=>(Line)context.GetAnalyticObject(line,p)).ToArray());
+        var definitions=lines.ToDictionary(line=>line,Definition);
+        var intersections=new Dictionary<(LineObject,LineObject),ConfigurationObject>();
+        ConfigurationObject Common(LineObject a,LineObject b)
+        {
+            if(intersections.TryGetValue((a,b),out var cached))return cached;
+            var first=definitions[a];var second=definitions[b];
+            var point=first.DefinedByPoints && second.DefinedByPoints ? first.Points.FirstOrDefault(second.Points.Contains) : null;
+            intersections[(a,b)]=point;intersections[(b,a)]=point;return point;
+        }
+        bool Elementary(Entry row,Entry old)
+        {
+            // Transport between already parallel directions adds no relation beyond ParallelLines.
+            if(Enumerable.Range(0,pictures.Length).All(p=>analytic[row.First][p].IsParallelTo(analytic[old.First][p]) &&
+                analytic[row.Second][p].IsParallelTo(analytic[old.Second][p])))return true;
+            // Only literal endpoints of the fixed statement count here. Using newly discovered
+            // incidences would make old theorem retention depend on later construction steps.
+            if(new[]{row.First,row.Second,old.First,old.Second}.Distinct().Count()!=4)return false;
+            // Four named cross-intersections turn this equation into ConcyclicPoints.
+            var vertices=new[]{Common(row.First,row.Second),Common(row.First,old.First),
+                Common(old.Second,row.Second),Common(old.Second,old.First)};
+            return vertices.All(p=>p!=null) && vertices.Distinct().Count()==4;
+        }
+        for(var i=0;i<lines.Length;i++)for(var j=0;j<i;j++)
+        {
+            var first=lines[j];var second=lines[i];var values=new (double x,double y)[pictures.Length];
+            for(var p=0;p<pictures.Length;p++)values[p]=MetricRelations.DirectionAngle(
+                analytic[first][p],analytic[second][p]);
+            // Parallel/perpendicular angles already have dedicated theorem types.
+            if(values.Any(v=>!double.IsFinite(v.x+v.y)) || Math.Abs(values[0].y)<MetricRelations.Tolerance)continue;
+            // Reverse both lines for a canonical acute orientation on the reference picture.
+            if(values[0].y<0){(first,second)=(second,first);for(var p=0;p<values.Length;p++)values[p].y=-values[p].y;}
+            var row=new Entry(first,second,values,added.Contains(first)||added.Contains(second));
+            var key=(long)Math.Floor(Math.Atan2(values[0].y,values[0].x)/cell);
+            for(var delta=-1;delta<=1;delta++)if(index.TryGetValue(key+delta,out var bucket))foreach(var old in bucket)
+            {
+                if(incremental && !row.New && !old.New)continue;
+                if(!Enumerable.Range(0,values.Length).All(p=>Math.Abs(values[p].x-old.Values[p].x)<=MetricRelations.Tolerance &&
+                    Math.Abs(values[p].y-old.Values[p].y)<=MetricRelations.Tolerance))continue;
+                if(Elementary(row,old))continue;
+                yield return new Theorem(Type,new TheoremObject[]{
+                    new AngleTheoremObject(definitions[first],definitions[second]),
+                    new AngleTheoremObject(definitions[old.First],definitions[old.Second])});
+            }
+            if(!index.TryGetValue(key,out var list))index[key]=list=new();list.Add(row);
+        }
+    }
+}

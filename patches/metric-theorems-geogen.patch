+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.TheoremFinder;
+using GeoGen.AnalyticGeometry;
+using NUnit.Framework;
+using Ninject;
+using System.Diagnostics;
+using static GeoGen.Core.PredefinedConstructions;
+namespace GeoGen.ConfigurationGenerator.Tests;
+[TestFixture]
+public class MetricRelationsTest
+{
+    [TestCase(TheoremType.LengthRatio2,4)] [TestCase(TheoremType.LengthRatio3,9)] [TestCase(TheoremType.SquaredLengthRatio2,2)]
+    public void Fixed_ratios_are_symmetric_nonzero_and_scale_invariant(TheoremType type,double factor)
+    {
+        Assert.That(MetricRelations.Factor(type),Is.EqualTo(factor));
+        foreach(var scale in new[]{1e-12,1.0,1e12}){
+            Assert.That(MetricRelations.Ratio(factor*scale,scale,factor),Is.True);
+            Assert.That(MetricRelations.Ratio(scale,factor*scale,factor),Is.True);
+            Assert.That(MetricRelations.Ratio((factor+.1)*scale,scale,factor),Is.False);
+        }
+        Assert.That(MetricRelations.Ratio(0,0,factor),Is.False);
+    }
+    [Test]
+    public void Angles_are_directed_modulo_pi_not_unsigned()
+    {
+        var horizontal=new Line(new Point(0,0),new Point(1,0));
+        var diagonal=new Line(new Point(0,0),new Point(1,1));
+        var reverse=new Line(new Point(3,3),new Point(2,2));
+        Assert.That(MetricRelations.Angles(horizontal,diagonal,horizontal,reverse),Is.True);
+        Assert.That(MetricRelations.Angles(horizontal,diagonal,diagonal,horizontal),Is.False);
+    }
+    [Test]
+    public void Angle_equations_canonicalize_regrouping_and_global_reversal()
+    {
+        var lines=Enumerable.Range(0,4).Select(_=>new LineTheoremObject(new LooseConfigurationObject(ConfigurationObjectType.Line))).ToArray();
+        Theorem Make(int a,int b,int c,int d)=>Theorem.DeriveFromFlattenedObjects(TheoremType.EqualAngles,new TheoremObject[]{lines[a],lines[b],lines[c],lines[d]});
+        var original=Make(0,1,2,3);
+        foreach(var other in new[]{Make(0,2,1,3),Make(1,0,3,2),Make(2,3,0,1)}){
+            Assert.That(other,Is.EqualTo(original));Assert.That(other.GetHashCode(),Is.EqualTo(original.GetHashCode()));
+        }
+        Assert.That(Make(1,0,2,3),Is.Not.EqualTo(original));
+    }
+    private static Configuration Configuration(int points)
+    {
+        var a=new LooseConfigurationObject(ConfigurationObjectType.Point);var b=new LooseConfigurationObject(ConfigurationObjectType.Point);var c=new LooseConfigurationObject(ConfigurationObjectType.Point);
+        var holder=new LooseObjectHolder(new[]{a,b,c},LooseObjectLayout.Triangle);
+        var m=new ConstructedConfigurationObject(Midpoint,b,c);
+        var defs=new List<ConstructedConfigurationObject>{m,
+            new(ComposedConstructions.Centroid,a,b,c),new(Midpoint,a,b),new(Midpoint,a,c),
+            new(ComposedConstructions.Incenter,a,b,c),new(ComposedConstructions.Circumcenter,a,b,c),new(ComposedConstructions.Orthocenter,a,b,c)};
+        return new Configuration(holder,defs.Take(points-3).ToArray());
+    }
+    [Test]
+    public void Indexed_finders_find_real_facts_and_incremental_length_facts()
+    {
+        var (_,constructor,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var configuration=Configuration(8);
+            var (pictures,data)=constructor.ConstructWithUniformLayout(configuration,3);
+            var context=new ContextualPicture(pictures);
+            foreach(ITypedTheoremFinder finder in new ITypedTheoremFinder[]{new LengthRatio2TheoremFinder(),new LengthRatio3TheoremFinder(),new EqualAnglesTheoremFinder()}){
+                var facts=finder.FindAllTheorems(context).ToArray();Assert.That(facts,Is.Not.Empty,finder.Type.ToString());
+                var formatter=new OutputFormatter(configuration.AllObjects);
+                foreach(var fact in facts){
+                    Assert.That(kernel.Get<IGeometricTheoremVerifier>().IsTrueInAllPictures(pictures,fact),Is.True);
+                    var text=formatter.FormatTheorem(fact);
+                    var names=configuration.AllObjects.ToDictionary(o=>formatter.GetObjectName(o),o=>o);
+                    Assert.That(Parser.ParseTheorem(text,names,false),Is.EqualTo(fact),text);
+                }
+            }
+        }
+    }
+    [Test]
+    public void Incremental_results_equal_a_full_rescan()
+    {
+        var (_,constructor,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var full=Configuration(8);var old=new Configuration(full.LooseObjectsHolder,full.ConstructedObjects.Take(full.ConstructedObjects.Count-1).ToArray());
+            var (oldPictures,_)=constructor.ConstructWithUniformLayout(old,3);var oldContext=new ContextualPicture(oldPictures);
+            var (newPictures,_data)=constructor.ConstructByCloning(oldPictures,full);var context=oldContext.ConstructByCloning(newPictures);
+            foreach(ITypedTheoremFinder finder in new ITypedTheoremFinder[]{new LengthRatio2TheoremFinder(),new LengthRatio3TheoremFinder(),new SquaredLengthRatio2TheoremFinder(),new EqualAnglesTheoremFinder()}){
+                var expected=finder.FindAllTheorems(context).ToHashSet();var actual=finder.FindAllTheorems(oldContext).Concat(finder.FindNewTheorems(context)).ToHashSet();
+                Assert.That(actual.SetEquals(expected),Is.True,finder.Type.ToString());
+            }
+        }
+    }
+    [Test]
+    public void Squared_ratio_finder_detects_a_right_angle_bisector_configuration()
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var a=new LooseConfigurationObject(ConfigurationObjectType.Point);var b=new LooseConfigurationObject(ConfigurationObjectType.Point);var c=new LooseConfigurationObject(ConfigurationObjectType.Point);
+            var d=new ConstructedConfigurationObject(ComposedConstructions.MidpointOfArc,a,b,c);
+            var e=new ConstructedConfigurationObject(ComposedConstructions.PerpendicularProjectionOnLineFromPoints,d,a,b);
+            var config=new Configuration(new LooseObjectHolder(new[]{a,b,c},LooseObjectLayout.RightTriangle),new[]{d,e});
+            var (pictures,data)=kernel.Get<IGeometryConstructor>().ConstructWithUniformLayout(config,3);
+            Assert.That(data.InconstructibleObject,Is.Null);
+            var facts=new SquaredLengthRatio2TheoremFinder().FindAllTheorems(new ContextualPicture(pictures)).ToArray();
+            Assert.That(facts,Is.Not.Empty);
+            foreach(var fact in facts)Assert.That(kernel.Get<IGeometricTheoremVerifier>().IsTrueInAllPictures(pictures,fact),Is.True);
+        }
+    }
+    [Test]
+    public void Record_finder_costs_on_six_eight_and_ten_point_configurations()
+    {
+        var (_,constructor,_,kernel)=SoftSearchTest.Services();using(kernel){
+            foreach(var n in new[]{6,8,10}){
+                var config=Configuration(n);var parent=new Configuration(config.LooseObjectsHolder,config.ConstructedObjects.Take(config.ConstructedObjects.Count-1).ToArray());
+                var (parentPictures,data)=constructor.ConstructWithUniformLayout(parent,3);var oldContext=new ContextualPicture(parentPictures);
+                var (pictures,childData)=constructor.ConstructByCloning(parentPictures,config);var context=oldContext.ConstructByCloning(pictures);
+                foreach(ITypedTheoremFinder finder in new ITypedTheoremFinder[]{new LengthRatio2TheoremFinder(),new LengthRatio3TheoremFinder(),new SquaredLengthRatio2TheoremFinder(),new EqualAnglesTheoremFinder(),new TangentCirclesTheoremFinder(new TangentCirclesTheoremFinderSettings(true))}){
+                    foreach(var mode in new[]{"all","new"}){
+                        IEnumerable<Theorem> Find()=>mode=="all" ? finder.FindAllTheorems(context) : finder.FindNewTheorems(context);
+                        var count=Find().Count();var samples=new List<double>();
+                        for(var repeat=0;repeat<7;repeat++){var clock=Stopwatch.StartNew();Assert.That(Find().Count(),Is.EqualTo(count));clock.Stop();samples.Add(clock.Elapsed.TotalMilliseconds);}
+                        samples.Sort();
+                        TestContext.Progress.WriteLine($"METRIC_BENCH n={n} mode={mode} type={finder.Type} count={count} medianMs={samples[3]:F3} minMs={samples[0]:F3} maxMs={samples[6]:F3}");
+                    }
+                }
+            }
+        }
+    }
+}

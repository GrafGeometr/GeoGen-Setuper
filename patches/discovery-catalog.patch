+using GeoGen.Core;
+using Newtonsoft.Json;
+
+namespace GeoGen.MainLauncher
+{
+    /// <summary>Export semantic signatures without initializing the runner or clearing outputs.</summary>
+    public static class CatalogExporter
+    {
+        private static object Parameter(ConstructionParameter parameter) => parameter switch
+        {
+            ObjectConstructionParameter p => new { type = p.ObjectType.ToString() },
+            SetConstructionParameter p => new { count = p.NumberOfParameters, item = Parameter(p.TypeOfParameters) },
+            _ => throw new InvalidOperationException("Unsupported construction parameter")
+        };
+
+        public static void Write(string file)
+        {
+            var constructions = Constructions.GetAllConstructions().OrderBy(c => c.Name).ToArray();
+            var data = new
+            {
+                version = 1,
+                constructions = constructions.Select(c => new
+                {
+                    name = c.Name,
+                    output = c.OutputType.ToString(),
+                    arguments = c.Signature.ObjectTypes.Select(t => t.ToString()),
+                    parameters = c.Signature.Parameters.Select(Parameter),
+                    composed = c is ComposedConstruction,
+                    definition = c is ComposedConstruction cc
+                        ? new OutputFormatter(cc.Configuration.AllObjects).FormatConfiguration(cc.Configuration) : null
+                }),
+                layouts = Enum.GetValues<LooseObjectLayout>().Select(l => new
+                {
+                    name = l.ToString(),
+                    arguments = l.ObjectTypes().Select(t => t.ToString())
+                })
+            };
+            File.WriteAllText(file, JsonConvert.SerializeObject(data, Formatting.Indented));
+        }
+    }
+}

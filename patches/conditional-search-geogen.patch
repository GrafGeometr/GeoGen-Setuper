diff --git a/Source/Launchers/GeoGen.MainLauncher/ConditionalCheckCommand.cs b/Source/Launchers/GeoGen.MainLauncher/ConditionalCheckCommand.cs
new file mode 100644
--- /dev/null
+++ b/Source/Launchers/GeoGen.MainLauncher/ConditionalCheckCommand.cs
@@ -0,0 +1,44 @@
+using System.Diagnostics;
+using System.Text.Json;
+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.Infrastructure;
+using GeoGen.ProblemGenerator;
+using Ninject;
+namespace GeoGen.MainLauncher;
+
+internal static class ConditionalCheckCommand
+{
+    public static void Run(string path)
+    {
+        var clock=Stopwatch.StartNew();
+        object result;
+        try {
+            using var document=JsonDocument.Parse(File.ReadAllText(path));var input=document.RootElement;
+            var configurationText=input.GetProperty("configuration").GetString();var conditionText=input.GetProperty("condition").GetString();var goalText=input.GetProperty("theorem").GetString();
+            var milliseconds=input.TryGetProperty("milliseconds",out var duration)?duration.GetInt32():15000;
+            if(milliseconds<1||milliseconds>3600000)throw new ArgumentException("Invalid conditional check budget");
+            var (configuration,names)=Parser.ParseConfiguration(configurationText.Split('\n'));
+            var condition=Parser.ParseTheorem(conditionText,names,false);var goal=Parser.ParseTheorem(goalText,names,false);
+            if(condition.Equals(goal)){Console.WriteLine("{\"status\":\"rejected\",\"message\":\"Conclusion repeats the condition\"}");return;}
+            var settings=new ConditionalSearchSettings{Seconds=milliseconds/1000.0,Samples=8,TraceFile=null};
+            using var kernel=NinjectUtilities.CreateKernel().AddConstructor();
+            void Deadline(){if(clock.Elapsed.TotalMilliseconds>=milliseconds)throw new TimeoutException();}
+            var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),configuration,settings,Deadline);
+            var random=new Random(ConditionalSearchEngine.StableSeed("verify|"+configurationText+"|"+conditionText+"|"+goalText));
+            var roots=sampler.On(condition,random);
+            if(roots.Count<settings.Samples)result=new{status="inconclusive",message="Could not obtain enough distinct regular samples satisfying the condition",samples=roots.Count};
+            else {
+                var counter=roots.FirstOrDefault(s=>!ConditionalPredicate.Holds(s.Picture,goal));
+                if(counter!=null)result=new{status="counterexample",message="The conclusion fails on a sample satisfying the condition",coordinates=counter.Parameters,conditionResidual=ConditionalPredicate.Residual(counter.Picture,condition),goalResidual=ConditionalPredicate.Residual(counter.Picture,goal)};
+                else {
+                    var generic=sampler.Generic(random,12);var counters=ConditionalSearchEngine.Counters(generic,condition,goal);
+                    result=counters.Length<2 ? (object)new{status="inconclusive",message="No sufficient counterexamples without the condition; essentiality is not confirmed",samples=roots.Count,genericSamples=generic.Count} :
+                        new{status="accepted",truth="conditioned-sampled-valid",samples=roots.Count,genericSamples=generic.Count,genericCounterexamples=counters.Length,counterexamples=counters,conditionSamples=roots.Select(s=>s.Parameters).ToArray(),draws=sampler.Draws,seconds=clock.Elapsed.TotalSeconds,notice="Numerical conditional conjecture; ordinary Extending weakening tests are not applied"};
+                }
+            }
+        } catch(TimeoutException){result=new{status="timeout",message="Conditional check exceeded time limit"};}
+        catch(Exception error){result=new{status="error",message=error.Message};}
+        Console.WriteLine(JsonSerializer.Serialize(result,ConditionalSearchSettings.JsonOptions));
+    }
+}

+using GeoGen.Core;
+using GeoGen.Utilities;
+using GeoGen.Constructor;
+using GeoGen.ProblemGenerator;
+using NUnit.Framework;
+using Ninject;
+using static GeoGen.Core.PredefinedConstructions;
+namespace GeoGen.ConfigurationGenerator.Tests;
+[TestFixture]
+public class ConditionalSamplerTest
+{
+    [Test]
+    public void Samples_an_extra_condition_and_finds_counterexamples_without_it()
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var a=new LooseConfigurationObject(ConfigurationObjectType.Point);var b=new LooseConfigurationObject(ConfigurationObjectType.Point);var c=new LooseConfigurationObject(ConfigurationObjectType.Point);
+            var o=new ConstructedConfigurationObject(ComposedConstructions.Circumcenter,a,b,c);
+            var h=new ConstructedConfigurationObject(ComposedConstructions.Orthocenter,a,b,c);
+            var config=new Configuration(new LooseObjectHolder(new[]{a,b,c},LooseObjectLayout.Triangle),new[]{o,h});
+            var condition=Theorem.DeriveFromFlattenedObjects(TheoremType.EqualLineSegments,new TheoremObject[]{new PointTheoremObject(a),new PointTheoremObject(b),new PointTheoremObject(a),new PointTheoremObject(c)});
+            var goal=new Theorem(TheoremType.CollinearPoints,a,o,h);
+            var settings=new ConditionalSearchSettings{Samples=8,Starts=80};
+            var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),config,settings);
+            var roots=sampler.On(condition,new Random(61));Assert.That(roots.Count,Is.EqualTo(8));
+            Assert.That(roots.All(s=>ConditionalPredicate.Holds(s.Picture,condition)),Is.True);
+            Assert.That(roots.All(s=>ConditionalPredicate.Holds(s.Picture,goal)),Is.True);
+            var generic=sampler.Generic(new Random(1201),8);
+            Assert.That(generic.Count(s=>Math.Abs(ConditionalPredicate.Residual(s.Picture,condition)??0)>1e-5 && Math.Abs(ConditionalPredicate.Residual(s.Picture,goal)??0)>1e-5),Is.GreaterThanOrEqualTo(2));
+        }
+    }
+    [Test]
+    public void Degenerate_triangle_condition_is_not_accepted_as_a_valid_picture()
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var input=SoftSearchTest.Input(SymmetryGenerationMode.GenerateBothSymmetricAndAsymmetric,1);
+            var config=input.InitialConfiguration;var points=config.LooseObjects;
+            var condition=new Theorem(TheoremType.CollinearPoints,points[0],points[1],points[2]);
+            var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),config,new ConditionalSearchSettings{Samples=4,Starts=4,Iterations=15});
+            Assert.That(sampler.On(condition,new Random(61)),Is.Empty);
+        }
+    }
+}

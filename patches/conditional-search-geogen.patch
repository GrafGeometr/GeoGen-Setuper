+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.Infrastructure;
+using GeoGen.TheoremFinder;
+using Ninject;
+using NUnit.Framework;
+using Newtonsoft.Json;
+namespace GeoGen.TheoremProver.Tests;
+[TestFixture]
+public class ConditionalSymmetryTest
+{
+    [Test]
+    public void Historical_settings_keep_symmetry_inference_enabled()
+    {
+        var settings=JsonConvert.DeserializeObject<TheoremProverSettings>("{\"AssumeThatSimplifiableTheoremsAreTrue\":false,\"FindTrivialTheoremsOnlyForLastObject\":false}");
+        Assert.That(settings.InferFromSymmetry,Is.True);
+    }
+    [TestCase(true)]
+    [TestCase(false)]
+    public void An_extra_premise_cannot_be_permuted_without_explicit_authorization(bool infer)
+    {
+        using var kernel=NinjectUtilities.CreateKernel().AddConstructor().AddTheoremFinder(new TheoremFindingSettings(new[]{TheoremType.EqualLineSegments},null,null));
+        kernel.AddTheoremProver(new TheoremProvingSettings(new InferenceRuleManagerData(Array.Empty<InferenceRule>()),
+            new ObjectIntroducerData(Array.Empty<ObjectIntroductionRule>()),new TheoremProverSettings(false,false,infer)));
+        var (configuration,names)=Parser.ParseConfiguration(new[]{"Triangle: A, B, C"});
+        var condition=Parser.ParseTheorem("EqualLineSegments: A, B, A, C",names,false);
+        var goal=Parser.ParseTheorem("EqualLineSegments: A, B, B, C",names,false);
+        var (pictures,_)=kernel.Get<IGeometryConstructor>().ConstructWithUniformLayout(configuration,3);
+        var proved=kernel.Get<ITheoremProver>().ProveTheoremsAndConstructProofs(new TheoremMap(new[]{condition}),new TheoremMap(new[]{goal}),new ContextualPicture(pictures));
+        Assert.That(proved.ContainsKey(goal),Is.EqualTo(infer));
+    }
+}

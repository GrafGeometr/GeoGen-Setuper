+    [Test]
+    public void Json_round_trip_and_sorting_preserve_the_joint_premise_and_conclusion()
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var (configuration,names)=Parser.ParseConfiguration(new[]{"Triangle: A, B, C"});
+            var premise=Parser.ParseTheorem("EqualLineSegments: A, B, A, C",names,false);
+            var goal=Parser.ParseTheorem("PerpendicularLines: [A, B], [B, C]",names,false);
+            var ranking=new GeoGen.TheoremRanker.TheoremRanking(new Dictionary<GeoGen.TheoremRanker.RankedAspect,GeoGen.TheoremRanker.RankingData>());
+            var original=new GeoGen.TheoremRanker.RankedTheorem(goal,ranking,configuration,new ConditionalProblemData(premise,new[]{new[]{.5,.8}},"{}"));
+            var intermediate=GeoGen.TheoremRanker.RankedTheoremIO.RankedTheoremIntermediate.Convert(original);
+            var json=Newtonsoft.Json.JsonConvert.SerializeObject(intermediate);
+            var restored=GeoGen.TheoremRanker.RankedTheoremIO.RankedTheoremIntermediate.Convert(Newtonsoft.Json.JsonConvert.DeserializeObject<GeoGen.TheoremRanker.RankedTheoremIO.RankedTheoremIntermediate>(json));
+            Assert.That(restored.Conditional.Samples[0],Is.EqualTo(new[]{.5,.8}));
+            Assert.That(new OutputFormatter(restored.Configuration.AllObjects).FormatTheorem(restored.Conditional.Assumption),Is.EqualTo(new OutputFormatter(configuration.AllObjects).FormatTheorem(premise)));
+            var sorter=new GeoGen.TheoremSorter.TheoremSorter(kernel.Get<IGeometryConstructor>(),new GeoGen.TheoremSorter.EmptySortingGeometryFailureTracer(),20);
+            var different=Parser.ParseTheorem("EqualLineSegments: A, B, B, C",names,false);
+            sorter.AddTheorems(new[]{original,new GeoGen.TheoremRanker.RankedTheorem(goal,ranking,configuration,new ConditionalProblemData(different,new[]{new[]{.5,.8}},"{}")),new GeoGen.TheoremRanker.RankedTheorem(goal,ranking,configuration)},out _);
+            Assert.That(sorter.BestTheorems.Count(),Is.EqualTo(3));
+        }
+    }

+{
+    [Test]
+    public void Discovers_only_terminal_conditional_goals_with_unconstrained_counterexamples()
+    {
+        var (generator,_,finder,kernel)=SoftSearchTest.Services();using(kernel){
+            var a=new LooseConfigurationObject(ConfigurationObjectType.Point);var b=new LooseConfigurationObject(ConfigurationObjectType.Point);var c=new LooseConfigurationObject(ConfigurationObjectType.Point);
+            var o=new ConstructedConfigurationObject(ComposedConstructions.Circumcenter,a,b,c);
+            var initial=new Configuration(new LooseObjectHolder(new[]{a,b,c},LooseObjectLayout.Triangle),new[]{o});
+            var input=new ProblemGeneratorInput(initial,new[]{(Construction)ComposedConstructions.Orthocenter}.ToReadOnlyHashSet(),1,
+                new Dictionary<ConfigurationObjectType,int>{{ConfigurationObjectType.Point,1},{ConfigurationObjectType.Line,0},{ConfigurationObjectType.Circle,0}},SymmetryGenerationMode.GenerateBothSymmetricAndAsymmetric);
+            var ordinary=generator.GenerateStandard(input).generationOutputs;
+            using var engine=new ConditionalSearchEngine(kernel.Get<IGeometryConstructor>(),finder,new ConditionalSearchSettings{
+                Seconds=20,Types=new[]{TheoremType.EqualLineSegments},Conditions=new[]{"EqualLineSegments: A, B, A, C"}});
+            var results=engine.Wrap(ordinary,input).ToArray();
+            Assert.That(results,Is.Not.Empty);
+            foreach(var frame in results){
+                Assert.That(frame.Configuration.IterationIndex,Is.EqualTo(1));Assert.That(frame.Conditional.Samples.Length,Is.EqualTo(8));
+                Assert.That(frame.NewTheorems.AllObjects.Contains(frame.Conditional.Assumption),Is.False);
+                var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),frame.Configuration,new ConditionalSearchSettings());
+                var generic=sampler.Generic(new Random(71),12);
+                foreach(var goal in frame.NewTheorems.AllObjects)
+                    Assert.That(ConditionalSearchEngine.Counters(generic,frame.Conditional.Assumption,goal).Length,Is.EqualTo(2));
+            }
+            Assert.That(engine.EssentialGoals,Is.GreaterThan(0));
+        }
+    }
+}

diff --git a/Source/Library/GeoGen.ProblemGenerator/ConditionalPredicate.cs b/Source/Library/GeoGen.ProblemGenerator/ConditionalPredicate.cs
new file mode 100644
--- /dev/null
+++ b/Source/Library/GeoGen.ProblemGenerator/ConditionalPredicate.cs
@@ -0,0 +1,82 @@
+using GeoGen.AnalyticGeometry;
+using GeoGen.Constructor;
+using GeoGen.Core;
+namespace GeoGen.ProblemGenerator;
+
+/// <summary>Dimensionless signed residuals. Undefined/degenerate statements have no residual.</summary>
+public static class ConditionalPredicate
+{
+    private static double Cross(Point a,Point b,Point c)=>(b.X-a.X)*(c.Y-a.Y)-(b.Y-a.Y)*(c.X-a.X);
+    public static double? Residual(Picture picture,Theorem theorem)
+    {
+        try {
+            var objects=theorem.InvolvedObjectsList;
+            Point P(TheoremObject obj)=>(Point)picture.Construct((BaseTheoremObject)obj);
+            Line L(TheoremObject obj)=>(Line)picture.Construct((BaseTheoremObject)obj);
+            Circle C(TheoremObject obj)=>(Circle)picture.Construct((BaseTheoremObject)obj);
+            double D(LineSegmentTheoremObject s)=>MetricRelations.SquaredDistance(P(s.Point1),P(s.Point2));
+            double value;
+            switch(theorem.Type){
+                case TheoremType.CollinearPoints:{
+                    var a=P(objects[0]);var b=P(objects[1]);var c=P(objects[2]);
+                    var scale=Math.Sqrt(MetricRelations.SquaredDistance(a,b)*MetricRelations.SquaredDistance(a,c));
+                    if(scale<1e-12)return null;value=Cross(a,b,c)/scale;break;
+                }
+                case TheoremType.ConcyclicPoints:{
+                    var points=objects.Select(P).ToArray();
+                    if(Math.Abs(Cross(points[0],points[1],points[2]))<1e-7)return null;
+                    var circle=new Circle(points[0],points[1],points[2]);var d=MetricRelations.SquaredDistance(points[3],circle.Center);var r=circle.Radius*circle.Radius;
+                    if(d+r<1e-12)return null;value=(d-r)/(d+r);break;
+                }
+                case TheoremType.ParallelLines:
+                case TheoremType.PerpendicularLines:{
+                    var a=L(objects[0]);var b=L(objects[1]);var scale=Math.Sqrt((a.A*a.A+a.B*a.B)*(b.A*b.A+b.B*b.B));
+                    if(scale<1e-12)return null;
+                    value=theorem.Type==TheoremType.ParallelLines ? (a.A*b.B-a.B*b.A)/scale : (a.A*b.A+a.B*b.B)/scale;break;
+                }
+                case TheoremType.EqualLineSegments:
+                case TheoremType.LengthRatio2:
+                case TheoremType.LengthRatio3:
+                case TheoremType.SquaredLengthRatio2:{
+                    var a=D((LineSegmentTheoremObject)objects[0]);var b=D((LineSegmentTheoremObject)objects[1]);if(Math.Min(a,b)<1e-12)return null;
+                    value=theorem.Type==TheoremType.EqualLineSegments ? (a-b)/(a+b) :
+                        (Math.Max(a,b)-MetricRelations.Factor(theorem.Type)*Math.Min(a,b))/(a+b);break;
+                }
+                case TheoremType.EqualAngles:{
+                    var u=(AngleTheoremObject)objects[0];var v=(AngleTheoremObject)objects[1];
+                    var a=L(u.First);var b=L(u.Second);var c=L(v.First);var d=L(v.Second);
+                    // Imaginary part of (b*c)*conjugate(a*d), divided by its norm.
+                    var bx=b.A*c.A-b.B*c.B;var by=b.A*c.B+b.B*c.A;
+                    var ax=a.A*d.A-a.B*d.B;var ay=a.A*d.B+a.B*d.A;
+                    var scale=Math.Sqrt((ax*ax+ay*ay)*(bx*bx+by*by));if(scale<1e-12)return null;
+                    value=(by*ax-bx*ay)/scale;break;
+                }
+                case TheoremType.ConcurrentLines:{
+                    var a=L(objects[0]);var b=L(objects[1]);var c=L(objects[2]);
+                    var cross=a.A*b.B-a.B*b.A;if(Math.Abs(cross)<1e-7)return null;
+                    var x=(a.B*b.C-a.C*b.B)/cross;var y=(a.C*b.A-a.A*b.C)/cross;
+                    value=(c.A*x+c.B*y+c.C)/(1+Math.Abs(x)+Math.Abs(y)+Math.Abs(c.C));break;
+                }
+                case TheoremType.Incidence:{
+                    var point=objects.OfType<PointTheoremObject>().Single();var other=objects.Single(o=>o!=point);var p=P(point);
+                    if(other is LineTheoremObject){var l=L(other);value=(l.A*p.X+l.B*p.Y+l.C)/(1+Math.Abs(p.X)+Math.Abs(p.Y)+Math.Abs(l.C));}
+                    else {var c=C(other);var d=MetricRelations.SquaredDistance(p,c.Center);var r=c.Radius*c.Radius;if(d+r<1e-12)return null;value=(d-r)/(d+r);}break;
+                }
+                case TheoremType.LineTangentToCircle:{
+                    var l=L(objects.OfType<LineTheoremObject>().Single());var c=C(objects.OfType<CircleTheoremObject>().Single());var d=l.A*c.Center.X+l.B*c.Center.Y+l.C;
+                    var r=c.Radius*c.Radius*(l.A*l.A+l.B*l.B);if(r<1e-12)return null;value=(d*d-r)/(d*d+r);break;
+                }
+                case TheoremType.TangentCircles:{
+                    var a=C(objects[0]);var b=C(objects[1]);var d=MetricRelations.SquaredDistance(a.Center,b.Center);
+                    var x=a.Radius*a.Radius;var y=b.Radius*b.Radius;if(d<1e-10 || Math.Min(x,y)<1e-12)return null;
+                    value=((d-x-y)*(d-x-y)-4*x*y)/((d+x+y)*(d+x+y));break;
+                }
+                default:return null;
+            }
+            return double.IsFinite(value) ? value : null;
+        }
+        catch(Exception e) when(e is AnalyticException or ConstructorException or GeoGenException or ArgumentException or InvalidOperationException or ArithmeticException){return null;}
+    }
+    public static bool Holds(Picture picture,Theorem theorem,double tolerance=2e-8)
+        =>Residual(picture,theorem) is double r && Math.Abs(r)<=tolerance;
+}
diff --git a/Source/Library/GeoGen.ProblemGenerator/ConditionalSampler.cs b/Source/Library/GeoGen.ProblemGenerator/ConditionalSampler.cs
new file mode 100644
--- /dev/null
+++ b/Source/Library/GeoGen.ProblemGenerator/ConditionalSampler.cs
@@ -0,0 +1,84 @@
+using GeoGen.AnalyticGeometry;
+using GeoGen.Constructor;
+using GeoGen.Core;
+namespace GeoGen.ProblemGenerator;
+
+public sealed record ConditionSample(double[] Parameters,Picture Picture);
+
+/// <summary>Black-box minimum-norm Newton projection for one scalar constraint in triangle shape space.</summary>
+public sealed class ConditionalSampler
+{
+    private readonly IGeometryConstructor _constructor;
+    private readonly Configuration _configuration;
+    private readonly ConditionalSearchSettings _settings;
+    private readonly Action _checkBudget;
+    public long Draws { get; private set; }
+    public long Iterations { get; private set; }
+    public ConditionalSampler(IGeometryConstructor constructor,Configuration configuration,ConditionalSearchSettings settings,Action checkBudget=null)
+    {
+        if(configuration.LooseObjectsHolder.Layout!=LooseObjectLayout.Triangle || configuration.LooseObjects.Count!=3)
+            throw new ArgumentException("Conditional sampling currently supports Triangle only");
+        _constructor=constructor;_configuration=configuration;_settings=settings;_checkBudget=checkBudget;
+    }
+    public ConditionSample Draw(double x,double y)
+    {
+        _checkBudget?.Invoke();Draws++;
+        if(!double.IsFinite(x+y) || x< -2 || x>3 || y<.06 || y>3)return null;
+        try {
+            var (pictures,data)=_constructor.Construct(_configuration,1,()=>new IAnalyticObject[]{new Point(0,0),new Point(1,0),new Point(x,y)});
+            if(pictures==null || data.InconstructibleObject!=null || data.Duplicates!=default)return null;
+            var picture=pictures.First();var points=new List<Point>();
+            foreach(var obj in _configuration.AllObjects){
+                var value=picture.Get(obj);
+                if(value is Point p){
+                    if(!double.IsFinite(p.X+p.Y) || Math.Abs(p.X)>100 || Math.Abs(p.Y)>100)return null;
+                    if(points.Any(q=>MetricRelations.SquaredDistance(p,q)<1e-10))return null;points.Add(p);
+                }
+                if(value is Circle c && (!double.IsFinite(c.Radius) || c.Radius<1e-6 || c.Radius>1000))return null;
+            }
+            return new ConditionSample(new[]{x,y},picture);
+        }
+        catch(Exception e) when(e is AnalyticException or ConstructorException or GeoGenException or ArgumentException or InvalidOperationException or ArithmeticException){return null;}
+    }
+    public List<ConditionSample> Generic(Random random,int count)
+    {
+        var result=new List<ConditionSample>();
+        for(var i=0;i<count*30 && result.Count<count;i++){
+            var sample=Draw(-.6+2.2*random.NextDouble(),.2+1.7*random.NextDouble());if(sample!=null)result.Add(sample);
+        }
+        return result;
+    }
+    private (ConditionSample sample,double residual)? At(Theorem condition,double x,double y)
+    {
+        var sample=Draw(x,y);if(sample==null)return null;
+        var residual=ConditionalPredicate.Residual(sample.Picture,condition);return residual.HasValue ? (sample,residual.Value) : null;
+    }
+    public List<ConditionSample> On(Theorem condition,Random random)
+    {
+        var roots=new List<ConditionSample>();
+        for(var start=0;start<_settings.Starts && roots.Count<_settings.Samples;start++){
+            var current=At(condition,-.6+2.2*random.NextDouble(),.2+1.7*random.NextDouble());
+            for(var iteration=0;current.HasValue && iteration<_settings.Iterations;iteration++){
+                _checkBudget?.Invoke();Iterations++;
+                var (sample,f)=current.Value;var x=sample.Parameters[0];var y=sample.Parameters[1];const double h=1e-5;
+                var xp=At(condition,x+h,y);var xm=At(condition,x-h,y);var yp=At(condition,x,y+h);var ym=At(condition,x,y-h);
+                if(!xp.HasValue||!xm.HasValue||!yp.HasValue||!ym.HasValue)break;
+                var gx=(xp.Value.residual-xm.Value.residual)/(2*h);var gy=(yp.Value.residual-ym.Value.residual)/(2*h);var norm=gx*gx+gy*gy;
+                if(!double.IsFinite(norm)||norm<1e-10)break;
+                if(Math.Abs(f)<1e-12){
+                    if(roots.All(old=>Math.Pow(old.Parameters[0]-x,2)+Math.Pow(old.Parameters[1]-y,2)>=_settings.MinSampleDistance*_settings.MinSampleDistance))roots.Add(sample);
+                    break;
+                }
+                var dx=-f*gx/(norm+1e-12);var dy=-f*gy/(norm+1e-12);var length=Math.Sqrt(dx*dx+dy*dy);
+                if(length>.4){dx*=.4/length;dy*=.4/length;}
+                (ConditionSample sample,double residual)? next=null;
+                for(var scale=1.0;scale>=1.0/128;scale*=.5){
+                    var trial=At(condition,x+scale*dx,y+scale*dy);
+                    if(trial.HasValue && Math.Abs(trial.Value.residual)<Math.Abs(f)){next=trial;break;}
+                }
+                if(!next.HasValue)break;current=next;
+            }
+        }
+        return roots;
+    }
+}
diff --git a/Source/Library/GeoGen.ProblemGenerator/ConditionalSearchEngine.cs b/Source/Library/GeoGen.ProblemGenerator/ConditionalSearchEngine.cs

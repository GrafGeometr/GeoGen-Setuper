@@ -0,0 +1,37 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using GeoGen.Core;
+namespace GeoGen.ProblemGenerator;
+public sealed class ConditionalSearchSettings
+{
+    public int Version { get; set; }=1;
+    public double Seconds { get; set; }=600;
+    public int Seed { get; set; }=61;
+    public TheoremType[] Types { get; set; }=new[]{TheoremType.CollinearPoints,TheoremType.ConcyclicPoints,TheoremType.ParallelLines,TheoremType.PerpendicularLines,TheoremType.EqualLineSegments};
+    public string[] Conditions { get; set; }=Array.Empty<string>();
+    public int MaxConditionsPerConfiguration { get; set; }=int.MaxValue;
+    public int Samples { get; set; }=8;
+    public int Starts { get; set; }=80;
+    public int Iterations { get; set; }=60;
+    public bool RequireLastObject { get; set; }=true;
+    public double MinSampleDistance { get; set; }=.04;
+    public string TraceFile { get; set; }
+    public static JsonSerializerOptions JsonOptions=>new(){PropertyNameCaseInsensitive=true,Converters={new JsonStringEnumConverter()}};
+    public void Validate()
+    {
+        var allowed=new[]{TheoremType.CollinearPoints,TheoremType.ConcyclicPoints,TheoremType.ParallelLines,TheoremType.PerpendicularLines,TheoremType.EqualLineSegments};
+        if(Version!=1 || !double.IsFinite(Seconds)||Seconds<=0 || Samples<4||Samples>32 || Starts<Samples||Starts>1000 || Iterations<1||Iterations>300 ||
+            MaxConditionsPerConfiguration<1 || !double.IsFinite(MinSampleDistance)||MinSampleDistance<=0||MinSampleDistance>.5 || Types==null||Types.Length==0||Types.Any(t=>!allowed.Contains(t)) || Conditions==null||Conditions.Any(string.IsNullOrWhiteSpace))
+            throw new ArgumentException("Invalid conditional search settings; supported premise types: collinearity, concyclicity, parallelism, perpendicularity, equal segments");
+    }
+    public static ConditionalSearchSettings Read(string path)
+    {
+        var settings=JsonSerializer.Deserialize<ConditionalSearchSettings>(File.ReadAllText(path),JsonOptions) ?? throw new ArgumentException("Empty condition settings");settings.Validate();
+        var output=Environment.GetEnvironmentVariable("GEOGEN_CONDITIONS_OUTPUT");
+        if(!string.IsNullOrEmpty(output)){
+            Directory.CreateDirectory(output);settings.TraceFile ??=Path.Combine(output,"conditions-trace.jsonl");
+            File.WriteAllText(Path.Combine(output,"conditions-settings.json"),JsonSerializer.Serialize(settings,JsonOptions));
+        }
+        return settings;
+    }
+}

+++ b/Source/Library/GeoGen.ProblemGenerator/ConditionalSearchEngine.cs
@@ -0,0 +1,127 @@
+using System.Diagnostics;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using GeoGen.ConfigurationGenerator;
+using GeoGen.Constructor;
+using GeoGen.Core;
+using GeoGen.TheoremFinder;
+namespace GeoGen.ProblemGenerator;
+
+internal sealed class ConditionDeadlineException:Exception { }
+
+public sealed class ConditionalSearchEngine : IDisposable
+{
+    private readonly IGeometryConstructor _constructor;
+    private readonly ITheoremFinder _finder;
+    private readonly ConditionalSearchSettings _settings;
+    private readonly Stopwatch _clock=Stopwatch.StartNew();
+    private readonly StreamWriter _trace;
+    private bool _disposed;
+    private int _ordinal;
+    public long Configurations,Terminals,ConditionsTried,GenericConditions,SolvedConditions,FailedSampling,Draws,SolverIterations,GoalsFound,EssentialGoals;
+    public ConditionalSearchEngine(IGeometryConstructor constructor,ITheoremFinder finder,ConditionalSearchSettings settings)
+    {
+        settings.Validate();_constructor=constructor;_finder=finder;_settings=settings;
+        if(settings.TraceFile!=null){Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(settings.TraceFile))!);_trace=new StreamWriter(settings.TraceFile);}
+        Log(new{kind="start",types=settings.Types,settings.Samples,settings.Seconds});
+    }
+    private void CheckBudget(){if(_clock.Elapsed.TotalSeconds>=_settings.Seconds)throw new ConditionDeadlineException();}
+    private void Log(object data){_trace?.WriteLine(JsonSerializer.Serialize(data,ConditionalSearchSettings.JsonOptions));_trace?.Flush();}
+    public static int StableSeed(string text)=>BitConverter.ToInt32(SHA256.HashData(Encoding.UTF8.GetBytes(text)),0);
+    private static IEnumerable<T[]> Combinations<T>(IReadOnlyList<T> values,int count,int from=0)
+    {
+        if(count==0){yield return Array.Empty<T>();yield break;}
+        for(var i=from;i<=values.Count-count;i++)foreach(var tail in Combinations(values,count-1,i+1))yield return new[]{values[i]}.Concat(tail).ToArray();
+    }
+    private static void Shuffle<T>(T[] values,Random random){for(var i=values.Length-1;i>0;i--){var j=random.Next(i+1);(values[i],values[j])=(values[j],values[i]);}}
+    private IEnumerable<Theorem> Candidates(ProblemGeneratorOutput frame,Random random)
+    {
+        var formatter=new OutputFormatter(frame.Configuration.AllObjects);
+        if(_settings.Conditions.Length>0){
+            var names=frame.Configuration.AllObjects.ToDictionary(formatter.GetObjectName);
+            foreach(var text in _settings.Conditions){var condition=Parser.ParseTheorem(text,names,false);if(!_settings.Types.Contains(condition.Type))throw new ArgumentException("Explicit condition type is not enabled");yield return condition;}yield break;
+        }
+        var points=frame.Configuration.AllObjects.Where(o=>o.ObjectType==ConfigurationObjectType.Point).ToArray();Shuffle(points,random);
+        var lines=frame.ContextualPicture.AllLines.Select(line=>line.ConfigurationObject!=null ? new LineTheoremObject(line.ConfigurationObject) :
+            new LineTheoremObject(line.Points.ElementAt(0).ConfigurationObject,line.Points.ElementAt(1).ConfigurationObject))
+            .OrderBy(formatter.FormatTheoremObject,StringComparer.Ordinal).ToArray();Shuffle(lines,random);
+        var segments=Combinations(points,2).Select(p=>new LineSegmentTheoremObject(p[0],p[1])).ToArray();Shuffle(segments,random);
+        IEnumerable<Theorem> OfType(TheoremType type)
+        {
+            if(type==TheoremType.CollinearPoints || type==TheoremType.ConcyclicPoints){
+                foreach(var tuple in Combinations(points,type==TheoremType.CollinearPoints?3:4))yield return new Theorem(type,tuple);
+            }else if(type==TheoremType.EqualLineSegments){
+                foreach(var pair in Combinations(segments,2))yield return new Theorem(type,pair.Cast<TheoremObject>());
+            }else foreach(var pair in Combinations(lines,2))yield return new Theorem(type,pair.Cast<TheoremObject>());
+        }
+        // Round robin prevents the first type from consuming the entire time budget.
+        var streams=_settings.Types.Distinct().Select(t=>OfType(t).GetEnumerator()).ToList();
+        try{while(streams.Count>0)for(var i=0;i<streams.Count;){CheckBudget();if(streams[i].MoveNext()){yield return streams[i].Current;i++;}else{streams[i].Dispose();streams.RemoveAt(i);}}}
+        finally{foreach(var stream in streams)stream.Dispose();}
+    }
+    public IEnumerable<ProblemGeneratorOutput> Wrap(IEnumerable<ProblemGeneratorOutput> ordinary,ProblemGeneratorInput input)
+    {
+        if(input.InitialConfiguration.LooseObjectsHolder.Layout!=LooseObjectLayout.Triangle)throw new ArgumentException("Conditional search currently supports Triangle only");
+        var budget=input.Constructions.Select(c=>c.OutputType).Distinct().Sum(t=>(long)input.MaximalNumbersOfObjectsToAdd[t]);
+        var last=(int)Math.Min(input.NumberOfIterations,budget);
+        try {
+            using var enumerator=ordinary.GetEnumerator();
+            while(true){
+                bool next;try{CheckBudget();next=enumerator.MoveNext();}catch(ConditionDeadlineException){yield break;}
+                if(!next)yield break;
+                Configurations++;var frame=enumerator.Current;if(frame.Configuration.IterationIndex<last)continue;Terminals++;
+                using var conditioned=Explore(frame).GetEnumerator();
+                while(true){try{CheckBudget();next=conditioned.MoveNext();}catch(ConditionDeadlineException){yield break;}if(!next)break;yield return conditioned.Current;}
+            }
+        } finally {Dispose();}
+    }
+    private IEnumerable<ProblemGeneratorOutput> Explore(ProblemGeneratorOutput frame)
+    {
+        var formatter=new OutputFormatter(frame.Configuration.AllObjects);
+        var random=new Random(StableSeed("generate|"+_settings.Seed+"|"+(++_ordinal)+"|"+formatter.FormatConfiguration(frame.Configuration)));
+        var sampler=new ConditionalSampler(_constructor,frame.Configuration,_settings,CheckBudget);
+        try {
+            var generic=sampler.Generic(random,6);if(generic.Count<6)yield break;
+            var known=frame.OldTheorems.AllObjects.Concat(frame.NewTheorems.AllObjects).Distinct().ToArray();var knownSet=known.ToHashSet();
+            var tried=0;
+            foreach(var condition in Candidates(frame,random)){
+                CheckBudget();if(tried++>=_settings.MaxConditionsPerConfiguration)break;ConditionsTried++;
+                if(ConditionsTried%16==0)Log(new{kind="progress",Configurations,Terminals,ConditionsTried,SolvedConditions,FailedSampling,EssentialGoals,draws=Draws+sampler.Draws,seconds=_clock.Elapsed.TotalSeconds});
+                if(condition.Type==TheoremType.CollinearPoints && condition.GetInnerConfigurationObjects().All(o=>frame.Configuration.LooseObjects.Contains(o)))continue;
+                if(generic.Count(s=>ConditionalPredicate.Residual(s.Picture,condition) is double r && Math.Abs(r)>1e-5)<2){GenericConditions++;continue;}
+                var roots=sampler.On(condition,random);
+                if(roots.Count<_settings.Samples){FailedSampling++;continue;}
+                ContextualPicture context;
+                try{context=new ContextualPicture(new PicturesOfConfiguration(frame.Configuration,roots.Select(s=>s.Picture).ToArray()));}
+                catch(InconsistentPicturesException){FailedSampling++;continue;}
+                SolvedConditions++;
+                var candidates=_finder.FindAllTheorems(context).AllObjects.Distinct().ToArray();GoalsFound+=candidates.Length;
+                var goals=new List<Theorem>();
+                foreach(var goal in candidates){
+                    CheckBudget();if(goal.Equals(condition)||knownSet.Contains(goal))continue;
+                    if(_settings.RequireLastObject && frame.Configuration.IterationIndex>0 &&
+                        !goal.GetInnerConfigurationObjects().Contains(frame.Configuration.LastConstructedObject) &&
+                        !condition.GetInnerConfigurationObjects().Contains(frame.Configuration.LastConstructedObject))continue;
+                    if(!roots.All(s=>ConditionalPredicate.Holds(s.Picture,goal)))continue;
+                    if(Counters(generic,condition,goal).Length<2)continue;
+                    goals.Add(goal);
+                }
+                EssentialGoals+=goals.Count;
+                Log(new{kind="condition",configuration=_ordinal,premise=formatter.FormatTheorem(condition),samples=roots.Count,goals=goals.Count,seconds=_clock.Elapsed.TotalSeconds});
+                if(goals.Count==0)continue;
+                var premises=known.Where(t=>roots.All(s=>ConditionalPredicate.Holds(s.Picture,t))).Append(condition);
+                var data=new ConditionalProblemData(condition,roots.Select(s=>s.Parameters).ToArray(),JsonSerializer.Serialize(_settings,ConditionalSearchSettings.JsonOptions),generic.Select(s=>s.Parameters).ToArray());
+                yield return new ProblemGeneratorOutput(frame.Configuration,context,new TheoremMap(premises),new TheoremMap(goals),data);
+            }
+        } finally {Draws+=sampler.Draws;SolverIterations+=sampler.Iterations;}
+    }
+    public static double[][] Counters(IEnumerable<ConditionSample> samples,Theorem condition,Theorem goal)=>samples.Where(s=>
+        ConditionalPredicate.Residual(s.Picture,condition) is double c && Math.Abs(c)>1e-5 &&
+        ConditionalPredicate.Residual(s.Picture,goal) is double g && Math.Abs(g)>1e-5).Select(s=>s.Parameters).Take(2).ToArray();
+    public void Dispose()
+    {
+        if(_disposed)return;_disposed=true;
+        Log(new{kind="finish",seconds=_clock.Elapsed.TotalSeconds,Configurations,Terminals,ConditionsTried,GenericConditions,SolvedConditions,FailedSampling,Draws,SolverIterations,GoalsFound,EssentialGoals});_trace?.Dispose();
+    }
+}

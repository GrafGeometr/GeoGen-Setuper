+namespace GeoGen.TheoremProver.Tests
+{
+    public class CustomConstructionsTest
+    {
+        private IKernel kernel;
+
+        [OneTimeSetUp]
+        public async Task Setup()
+        {
+            kernel = NinjectUtilities.CreateKernel().AddConstructor().AddTheoremFinder(new TheoremFindingSettings(
+                Enum.GetValues<TheoremType>().Except(new[] { TheoremType.EqualObjects }).ToArray(),
+                new TangentCirclesTheoremFinderSettings(false), new LineTangentToCircleTheoremFinderSettings(false)));
+            var rules = await new InferenceRuleProvider.InferenceRuleProvider(new InferenceRuleProviderSettings(
+                Path.Combine(TestContext.CurrentContext.TestDirectory, "InferenceRules"), "txt")).GetInferenceRulesAsync();
+            var introductions = await new ObjectIntroductionRuleProvider.ObjectIntroductionRuleProvider(new ObjectIntroductionRuleProviderSettings(
+                Path.Combine(TestContext.CurrentContext.TestDirectory, "object_introduction_rules.txt"))).GetObjectIntroductionRulesAsync();
+            kernel.AddTheoremProver(new TheoremProvingSettings(new InferenceRuleManagerData(rules), new ObjectIntroducerData(introductions),
+                new TheoremProverSettings(assumeThatSimplifiableTheoremsAreTrue: false, findTrivialTheoremsOnlyForLastObject: false)));
+        }
+
+        [OneTimeTearDown]
+        public void Teardown() => kernel.Dispose();
+
+        private void AssertProved(Configuration configuration, params Theorem[] targets)
+        {
+            var (pictures, data) = kernel.Get<IGeometryConstructor>().ConstructWithUniformLayout(configuration, 3);
+            data.InconstructibleObject.Should().BeNull();
+            (data.Duplicates == default).Should().BeTrue();
+            var picture = new ContextualPicture(pictures);
+            var facts = kernel.Get<ITheoremFinder>().FindAllTheorems(picture);
+            facts.AllObjects.Should().Contain(targets);
+            var proofs = kernel.Get<ITheoremProver>().ProveTheoremsAndConstructProofs(new TheoremMap(), facts, picture);
+            proofs.Keys.Should().Contain(targets);
+        }
+
+        [TestCase("HeightMiddle")]
+        [TestCase("MedianMiddle")]
+        [TestCase("BisectorMiddle")]
+        [TestCase("ExternalBisectorMiddle")]
+        [TestCase("SymedianMiddle")]
+        [TestCase("RadiusLineMiddle")]
+        public void Middle_Lies_On_Midline_And_Line_Through_Side_Midpoints(string name)
+        {
+            var A = new LooseConfigurationObject(Point); var B = new LooseConfigurationObject(Point); var C = new LooseConfigurationObject(Point);
+            var X = new ConstructedConfigurationObject(Constructions.GetComposedConstruction(name), A, B, C);
+            var line = new ConstructedConfigurationObject(Midline, A, B, C);
+            var D = new ConstructedConfigurationObject(Midpoint, A, B);
+            var E = new ConstructedConfigurationObject(Midpoint, A, C);
+            var holder = new LooseObjectHolder(new[] { A, B, C }, LooseObjectLayout.Triangle);
+            var target1 = new Theorem(TheoremType.Incidence, X, line);
+            var target2 = new Theorem(TheoremType.CollinearPoints, D, E, X);
+            AssertProved(new Configuration(holder, new[] { line, D, E, X }), target1, target2);
+            AssertProved(new Configuration(holder, new[] { X, E, D, line }), target1, target2);
+        }
+
+        [TestCase("HeightMiddle", "PerpendicularProjectionOnLineFromPoints")]
+        [TestCase("MedianMiddle", "Midpoint")]
+        [TestCase("BisectorMiddle", "BisectorEnd")]
+        [TestCase("ExternalBisectorMiddle", "ExternalBisectorEnd")]
+        [TestCase("SymedianMiddle", "SymedianEnd")]
+        [TestCase("RadiusLineMiddle", "RadiusLineEnd")]
+        public void Middle_Has_The_Defining_Half_Lengths_And_Lies_On_The_Segment(string middle, string end)
+        {
+            var A = new LooseConfigurationObject(Point); var B = new LooseConfigurationObject(Point); var C = new LooseConfigurationObject(Point);
+            var X = new ConstructedConfigurationObject(Constructions.GetComposedConstruction(middle), A, B, C);
+            var T = end == "Midpoint" ? new ConstructedConfigurationObject(Midpoint, B, C)
+                : new ConstructedConfigurationObject(Constructions.GetComposedConstruction(end), A, B, C);
+            var configuration = new Configuration(new LooseObjectHolder(new[] { A, B, C }, LooseObjectLayout.Triangle), new[] { T, X });
+            AssertProved(configuration, new Theorem(TheoremType.CollinearPoints, A, T, X),
+                new Theorem(TheoremType.EqualLineSegments, new TheoremObject[] { new LineSegmentTheoremObject(A, X), new LineSegmentTheoremObject(T, X) }));
+        }
+
+        [TestCase(PredefinedConstructionType.InversionOfPoint)]
+        [TestCase(PredefinedConstructionType.CenterOfNegativeHomothety)]
+        [TestCase(PredefinedConstructionType.CenterOfPositiveHomothety)]
+        public void Custom_Primitives_Can_Be_Analyzed_And_Related_To_Their_Centers(PredefinedConstructionType type)
+        {
+            var A = new LooseConfigurationObject(Point); var B = new LooseConfigurationObject(Point); var C = new LooseConfigurationObject(Point);
+            var c = new ConstructedConfigurationObject(CircleWithDiameter, A, B);
+            var d = new ConstructedConfigurationObject(Circumcircle, A, B, C);
+            var O = new ConstructedConfigurationObject(CenterOfCircle, c);
+            var P = new ConstructedConfigurationObject(CenterOfCircle, d);
+            var X = type == PredefinedConstructionType.InversionOfPoint ? new ConstructedConfigurationObject(type, C, c)
+                : new ConstructedConfigurationObject(type, c, d);
+            var objects = type == PredefinedConstructionType.InversionOfPoint ? new[] { c, O, X } : new[] { c, d, O, P, X };
+            var target = new Theorem(TheoremType.CollinearPoints, O, type == PredefinedConstructionType.InversionOfPoint ? C : P, X);
+            AssertProved(new Configuration(new LooseObjectHolder(new[] { A, B, C }, LooseObjectLayout.Triangle), objects), target);
+        }
+    }
+}

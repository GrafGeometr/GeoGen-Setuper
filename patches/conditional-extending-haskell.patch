 validateOne :: FilePath -> Int -> Int -> Int -> String -> IO ()
 validateOne file milliseconds count seed domain = do
+    contents <- readFile file
+    if conditionalContents contents then putStrLn "{\"status\":\"inconclusive\",\"message\":\"Conditional statements require --check-file or Geometry Suite conditional validation\"}"
+    else validateOrdinary file milliseconds count seed domain
+
+validateOrdinary :: FilePath -> Int -> Int -> Int -> String -> IO ()
+validateOrdinary file milliseconds count seed domain = do
     outcome <- try (timeout (milliseconds * 1000) $ do
         contents <- readFile file
         _ <- evaluate (length contents)

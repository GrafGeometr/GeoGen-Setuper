 -- inside the timeout; runRand alone can return a thunk whose work happens later.
 checkOne :: FilePath -> Int -> IO ()
 checkOne file milliseconds = do
+    contents <- readFile file
+    if conditionalContents contents then nativeConditional file milliseconds >>= putStrLn else checkOrdinary file milliseconds
+
+conditionalContents :: String -> Bool
+conditionalContents = any isCondition . lines
+  where
+    isCondition line = case dropWhile isSpace line of
+        '!':rest -> "Assume:" `isPrefixOf` dropWhile isSpace rest
+        _ -> False
+
+concatWithComma :: [String] -> String
+concatWithComma [] = ""
+concatWithComma (x:xs) = x <> concatMap (',' :) xs
+
+nativeConditional :: FilePath -> Int -> IO String
+nativeConditional file milliseconds = do
+    result <- try (timeout ((milliseconds + 5000) * 1000) $ do
+        executable <- getExecutablePath
+        customDotnet <- lookupEnv "GEOMETRY_CONDITIONAL_DOTNET"
+        customDll <- lookupEnv "GEOMETRY_CONDITIONAL_DLL"
+        let folder = takeDirectory executable
+            dotnet = maybe (folder </> ".." </> "dotnet" </> "dotnet") id customDotnet
+            dll = maybe (folder </> ".." </> "geogen" </> "GeoGen.MainLauncher.dll") id customDll
+        (code,output,errors) <- readProcessWithExitCode dotnet [dll,"--extend-conditional-geo",file,show milliseconds] ""
+        case code of
+            ExitSuccess -> pure output
+            _ -> ioError (userError ("Native conditional backend failed: " <> errors <> output))) :: IO (Either SomeException (Maybe String))
+    pure $ case result of
+        Left err -> "{\"status\":\"error\",\"message\":" <> jsonString (displayException err) <> "}"
+        Right Nothing -> "{\"status\":\"timeout\",\"message\":\"Conditional worker exceeded process deadline\"}"
+        Right (Just output) -> output
+
+checkOrdinary :: FilePath -> Int -> IO ()
+checkOrdinary file milliseconds = do
     outcome <- try (timeout (milliseconds * 1000) $ do
         contents <- readFile file
         _ <- evaluate (length contents)

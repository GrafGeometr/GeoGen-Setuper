@@ -92,3 +101,48 @@ jsonString text = "\"" <> concatMap escape text <> "\""
         escape '\\' = "\\\\"
         escape c | ord c < 32 = let hex = showHex (ord c) "" in "\\u" <> replicate (4 - length hex) '0' <> hex
                  | otherwise = [c]
+
+
+validateOne :: FilePath -> Int -> Int -> Int -> String -> IO ()
+validateOne file milliseconds count seed domain = do
+    outcome <- try (timeout (milliseconds * 1000) $ do
+        contents <- readFile file
+        _ <- evaluate (length contents)
+        let clean = unlines . fmap tail . filter ("!" `isPrefixOf`) . lines $ contents
+            firstLine = takeWhile (/='\n') clean
+            layout = takeWhile (/=':') firstLine
+            initial = words (map (\c -> if c == ',' then ' ' else c) (drop 1 (dropWhile (/=':') firstLine)))
+        case parseTheorem file clean of
+            Left err -> ioError (userError (show err))
+            Right (cs, cc) -> loop layout initial cs cc 0 0
+        ) :: IO (Either SomeException (Maybe String))
+    putStrLn $ case outcome of
+        Left err -> "{\"status\":\"error\",\"message\":" <> jsonString (displayException err) <> "}"
+        Right Nothing -> "{\"status\":\"inconclusive\",\"message\":\"Validation timed out\"}"
+        Right (Just result) -> result
+  where
+    loop layout initial cs cc passed invalid
+      | passed >= count = pure ("{\"status\":\"sampled-valid\",\"samples\":" <> show passed <> ",\"invalidSamples\":" <> show invalid <> ",\"seed\":" <> show seed <> "}")
+      | passed + invalid >= count * 20 = pure "{\"status\":\"inconclusive\",\"message\":\"Not enough nondegenerate samples\"}"
+      | otherwise = do
+          let sampleSeed = seed + passed + invalid
+          result <- try (evaluate (runRandSeed sampleSeed (validateOriginal domain layout initial cs cc)) >>= \value ->
+                    case value of {Nothing -> pure Nothing; Just b -> evaluate b >>= (pure . Just)}) :: IO (Either SomeException (Maybe Bool))
+          case result of
+              Left err -> case (fromException err :: Maybe AsyncException) of
+                  Just _ -> throwIO err
+                  Nothing -> if "Ratio has zero denominator" `isPrefixOf` displayException err
+                             then loop layout initial cs cc passed (invalid+1) else throwIO err
+              Right Nothing -> loop layout initial cs cc passed (invalid+1)
+              Right (Just True) -> loop layout initial cs cc (passed+1) invalid
+              Right (Just False) -> do
+                  let picture = runRandSeed sampleSeed (originalObjects (take (length initial) cs))
+                      points = [(name,p) | name <- initial, PointShape p <- [picture Map.! name]]
+                      coords = "[" <> joinComma ["{\"name\":" <> jsonString name <> ",\"x\":" <> jsonString (show (F.re p)) <> ",\"y\":" <> jsonString (show (F.im p)) <> "}" | (name,p) <- points] <> "]"
+                      acute = case map snd points of
+                          [a,b,c] -> all (>0) [F.re((b-a)*F.conj(c-a)),F.re((a-b)*F.conj(c-b)),F.re((a-c)*F.conj(b-c))]
+                          _ -> False
+                  pure ("{\"status\":\"counterexample\",\"samples\":" <> show passed <> ",\"sampleSeed\":" <> show sampleSeed <> ",\"acute\":" <> (if acute then "true" else "false") <> ",\"initialPoints\":" <> coords <> "}")
+    joinComma [] = ""
+    joinComma [x] = x
+    joinComma (x:xs) = x <> "," <> joinComma xs

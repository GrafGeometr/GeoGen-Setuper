 check10 :: [Command] -> Conclusion -> Rand Bool
 check10 xs c = or <$> replicateM 10 (check Map.empty xs c)
+
+
+-- Evaluate only the original definitions. This is independent of weakening tests.
+validateOriginal :: String -> String -> [String] -> [Command] -> Conclusion -> Rand (Maybe Bool)
+validateOriginal domain layout initial cs conclusion = build Map.empty cs
+  where
+    build m [] =
+      let points = [p | PointShape p <- Map.elems m]
+          root = [p | name <- initial, PointShape p <- [m Map.! name]]
+          noncollinear [a,b,c] = not (F.checkReal ((b-a) * F.conj (c-a)))
+          noncollinear _ = False
+          acute [a,b,c] = all (>0) [F.re((b-a)*F.conj(c-a)),F.re((a-b)*F.conj(c-b)),F.re((a-c)*F.conj(b-c))]
+          acute _ = False
+          convex [a,b,c,d] = let turns=[F.im((b-a)*F.conj(c-b)),F.im((c-b)*F.conj(d-c)),F.im((d-c)*F.conj(a-d)),F.im((a-d)*F.conj(b-a))]
+                             in all (>0) turns || all (<0) turns
+          convex _ = False
+          validLayout = case layout of
+              "LineSegment" -> length root == 2
+              "Triangle" -> noncollinear root && (domain /= "acute" || acute root)
+              "RightTriangle" -> noncollinear root && F.re ((root!!1-root!!0) * F.conj (root!!2-root!!0)) == 0
+              "Quadrilateral" -> convex root
+              "CyclicQuadrilateral" -> convex root
+              _ -> False
+          validShape (PointShape p) = F.norm p >= 0
+          validShape (LineShape l) = F.norm (coef l) > 0
+          validShape (CircleShape c) = radiusSqr c > 0 && F.norm (center c) >= 0
+      in pure $ if validLayout && length (nub points) == length points && all validShape (Map.elems m)
+                then Just (factChecker conclusion (getShps m (arguments conclusion))) else Nothing
+    build m (Command r xs f : rest) = last (f (getShps m xs)) >>= \shape -> build (Map.insert r shape m) rest
+
+
+originalObjects :: [Command] -> Rand (Map.Map String Shape)
+originalObjects = build Map.empty
+  where
+    build m [] = pure m
+    build m (Command r xs f : rest) = last (f (getShps m xs)) >>= \shape -> build (Map.insert r shape m) rest

+namespace GeoGen.TheoremProver.Tests
+{
+    public class AdditionalCustomConstructionsTest
+    {
+        private IKernel kernel;
+        private readonly InvalidTracer tracer = new();
+        private static IReadOnlyList<LoadedInferenceRule> Rules => new InferenceRuleProvider.InferenceRuleProvider(

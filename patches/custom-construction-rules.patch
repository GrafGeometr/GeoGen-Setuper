+                }
+                case "isotomic": {
+                    layout=LooseObjectLayout.Quadrilateral;
+                    var x=Make(Isotomic,P,A,B,C);var t=Make(IntersectionOfLinesFromPoints,A,P,B,C);var u=Make(IntersectionOfLinesFromPoints,A,x,B,C);var m=Make(Midpoint,B,C);
+                    objects.AddRange(new[]{x,t,u,m});targets.Add(Equal(m,t,m,u));wrong=Equal(B,t,B,u);break;
+                }
+                case "antigonal": {
+                    layout=LooseObjectLayout.Quadrilateral;
+                    var r=Make(ReflectionInLineFromPoints,P,B,C);var x=Make(Antigonal,P,A,B,C);objects.AddRange(new[]{r,x});
+                    targets.Add(new Theorem(ConcyclicPoints,x,B,C,r));wrong=new Theorem(ConcyclicPoints,x,A,C,r);break;
+                }
+                case "harmonic": {
+                    var c=Make(CircleWithDiameter,B,C);var i=Make(InversionOfPoint,A,c);var l=Make(LineFromPoints,B,C);var x=Make(Harmonic,A,B,C);
+                    objects.AddRange(new[]{c,i,l,x});targets.Add(Per(i,x,l));wrong=Col(B,C,x);break;
+                }
+
+            }
+            var configuration=Configuration.DeriveFromObjects(layout,objects.Cast<ConfigurationObject>().ToArray());
+            var (pictures,data)=kernel.Get<IGeometryConstructor>().ConstructWithUniformLayout(configuration,3);
+            data.InconstructibleObject.Should().BeNull(name);(data.Duplicates==default).Should().BeTrue(name);
+            var picture=new ContextualPicture(pictures);var facts=kernel.Get<ITheoremFinder>().FindAllTheorems(picture);
+            facts.AllObjects.Should().Contain(targets,name);
+            kernel.Get<IGeometricTheoremVerifier>().IsTrueInAllPictures(pictures.Clone(),wrong).Should().BeFalse("wrong analogous claim for "+name);
+            tracer.Errors.Clear();
+            var proofs=kernel.Get<ITheoremProver>().ProveTheoremsAndConstructProofs(new TheoremMap(),facts,picture);
+            proofs.Keys.Should().Contain(targets,name);
+            proofs.Keys.Should().NotContain(wrong);
+            var withoutProofs=kernel.Get<ITheoremProver>().ProveTheorems(new TheoremMap(),facts,picture);

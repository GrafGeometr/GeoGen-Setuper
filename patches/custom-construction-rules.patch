+using FluentAssertions;
+using GeoGen.Core;
+using NUnit.Framework;
+using static GeoGen.Core.ConfigurationObjectType;
+using static GeoGen.Core.PredefinedConstructions;
+using static GeoGen.Core.TheoremType;
+
+namespace GeoGen.TheoremProver.Tests
+{
+    public class DefiningObjectsProofTest
+    {
+        [Test]
+        public void Implicit_Defining_Incidence_Has_A_Proof_But_An_Arbitrary_Incidence_Does_Not()
+        {
+            var A=new LooseConfigurationObject(Point);var B=new LooseConfigurationObject(Point);var C=new LooseConfigurationObject(Point);
+            var l=new LineTheoremObject(A,B);
+            var definition=new Theorem(Incidence,new TheoremObject[]{new PointTheoremObject(A),l});
+            var result=new Theorem(Incidence,A,new ConstructedConfigurationObject(LineFromPoints,A,B));
+            var builder=new TheoremProofBuilder();
+            builder.AddImplication(InferenceRuleType.CustomRule,result,new[]{definition});
+            builder.BuildProofs(new[]{definition}).Should().ContainKey(definition);
+            var unrelated=new Theorem(Incidence,new TheoremObject[]{new PointTheoremObject(C),l});
+            var other=new TheoremProofBuilder();
+            Action invalid=()=>other.AddImplication(InferenceRuleType.CustomRule,result,new[]{unrelated});
+            invalid.Should().Throw<TheoremProverException>();
+        }
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public void Explicit_And_Implicit_Shape_Notations_Reuse_Actual_Proofs(bool circle)
+        {
+            var A=new LooseConfigurationObject(Point);var B=new LooseConfigurationObject(Point);var C=new LooseConfigurationObject(Point);
+            var D=new LooseConfigurationObject(Point);var E=new LooseConfigurationObject(Point);
+            Theorem known;Theorem alternate;
+            if(circle)
+            {
+                var c=new ConstructedConfigurationObject(Circumcircle,A,B,C);
+                known=new Theorem(Incidence,D,c);
+                alternate=new Theorem(Incidence,new TheoremObject[]{new PointTheoremObject(D),new CircleTheoremObject(A,B,C)});
+            }
+            else
+            {
+                var l=new ConstructedConfigurationObject(LineFromPoints,A,B);
+                known=new Theorem(PerpendicularLines,new TheoremObject[]{new LineTheoremObject(l),new LineTheoremObject(C,D)});
+                alternate=new Theorem(PerpendicularLines,new TheoremObject[]{new LineTheoremObject(A,B),new LineTheoremObject(C,D)});
+            }
+            var result=alternate;
+            var builder=new TheoremProofBuilder();
+            builder.AddImplication(InferenceRuleType.AssumedProven,known,Array.Empty<Theorem>());
+            builder.AddImplication(InferenceRuleType.CustomRule,result,new[]{alternate});
+            var proof=builder.BuildProofs(new[]{result});
+            proof.Should().ContainKey(result);
+            // A notation change cannot establish the geometric fact from nothing.
+            var empty=new TheoremProofBuilder();
+            Action invalid=()=>empty.AddImplication(InferenceRuleType.CustomRule,result,new[]{alternate});
+            invalid.Should().Throw<TheoremProverException>();
+        }
+    }
+}

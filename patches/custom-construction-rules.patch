+                    var x=Make(name=="humpty"?HumptyPoint:DumptyPoint,A,B,C);objects.AddRange(new[]{center,line,x});targets.AddRange(new[]{Inc(x,line),Per(center,x,line)});
+                    wrong=Inc(x,Make(LineFromPoints,B,C));break;

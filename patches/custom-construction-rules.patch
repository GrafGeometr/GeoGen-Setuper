+                    var x=Make(name=="bisector"?BisectorEnd:ExternalBisectorEnd,A,B,C);objects.AddRange(new[]{l,x});targets.Add(Inc(x,l));
+                    wrong=Inc(x,Make(InternalAngleBisector,B,A,C));break;
+                }
+                case "symedian-end": {
+                    var l=Make(Symedian,A,B,C);var t=Make(TangentLinesIntersection,A,B,C);var x=Make(SymedianEnd,A,B,C);

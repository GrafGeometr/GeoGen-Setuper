+                }
+                case "isotomic-gergonne": {
+                    var g=Make(Gergonne,A,B,C);var e=Make(Excenter,A,B,C);var t=Make(PerpendicularProjectionOnLineFromPoints,e,B,C);var x=Make(Isotomic,g,A,B,C);

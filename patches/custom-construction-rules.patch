+                new TheoremProverSettings(false, false)));
+            kernel.Rebind<IInvalidInferenceTracer>().ToConstant(tracer);
+        }
+        [OneTimeTearDown] public void Teardown() => kernel.Dispose();
+
+        public static IEnumerable<TestCaseData> GeometricRules() => Rules
+            .Where(rule => rule.RelativeFileName.Contains("AdditionalCustomConstructions") && rule.NeededAssumptionTypes.Count == 0)
+            .Select(rule => new TestCaseData(rule).SetName("Geometry_"+Path.GetFileNameWithoutExtension(rule.RelativeFileName)+"_"+rule.Number));
+
+        [TestCaseSource(nameof(GeometricRules))]
+        public void Every_Unconditional_New_Rule_Holds_In_Five_Independent_Pictures(LoadedInferenceRule rule)
+        {
+            var objects = rule.DeclaredObjects.Cast<ConfigurationObject>().ToArray();
+            var loose = objects.GetDefiningObjects().OfType<LooseConfigurationObject>().Distinct().ToArray();
+            var layout = loose.Length == 4 ? LooseObjectLayout.Quadrilateral : LooseObjectLayout.Triangle;
+            loose.Length.Should().BeOneOf(3,4);
+            var configuration = Configuration.DeriveFromObjects(layout, objects);

+            .GetInferenceRulesAsync().GetAwaiter().GetResult();
+
+        [OneTimeSetUp]
+        public async Task Setup()
+        {
+            kernel = NinjectUtilities.CreateKernel().AddConstructor().AddTheoremFinder(new TheoremFindingSettings(
+                Enum.GetValues<TheoremType>().Except(new[] { EqualObjects }).ToArray(),
+                new TangentCirclesTheoremFinderSettings(false), new LineTangentToCircleTheoremFinderSettings(false)));
+            var introductions = await new ObjectIntroductionRuleProvider.ObjectIntroductionRuleProvider(new ObjectIntroductionRuleProviderSettings(

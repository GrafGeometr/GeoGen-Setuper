         public IReadOnlyDictionary<Theorem, TheoremProof> BuildProofs(IEnumerable<Theorem> theorems)
         {
+            theorems = theorems.ToArray();
+            foreach (var theorem in theorems)
+                EnsureNotationProof(theorem);
+
             // Prepare a dictionary mapping theorems to their proofs
             var proofDictionary = new Dictionary<Theorem, TheoremProof>();
 
@@ -113,6 +117,9 @@ namespace GeoGen.TheoremProver
         /// <param name="assumptions">The assumptions that imply the conclusion.</param>
         public void AddImplication(TheoremInferenceData inferenceData, Theorem conclusion, IEnumerable<Theorem> assumptions)
         {
+            foreach (var assumption in assumptions.ToArray())
+                EnsureNotationProof(assumption);
+
             #region Trying to infer unproved EqualObjects assumptions
 
             // The equality helper has taken care of equality assumptions that might be inferred via transitivity.
@@ -213,6 +220,29 @@ namespace GeoGen.TheoremProver
 
         #region Private methods
 
+        // A notation change can only reuse an existing proof or a literal
+        // defining-point incidence. It cannot establish a new geometric claim.
+        private void EnsureNotationProof(Theorem theorem)
+        {
+            if (_knowledgeBase.ContainsKey(theorem) || theorem.Type == EqualObjects)
+                return;
+            var flattened = TheoremNotation.Flatten(theorem);
+            if (flattened.Type == Incidence)
+            {
+                var point = flattened.InvolvedObjects.OfType<PointTheoremObject>().Single();
+                var shape = flattened.InvolvedObjects.OfType<TheoremObjectWithPoints>().Single();
+                if (shape.DefinedByPoints && shape.Points.Contains(point.ConfigurationObject))
+                {
+                    _knowledgeBase.Add(theorem, (new TheoremInferenceData(TrivialTheorem), Array.Empty<Theorem>()));
+                    return;
+                }
+            }
+            var equivalent = _knowledgeBase.Keys.FirstOrDefault(known => known.Type == theorem.Type
+                && Equals(TheoremNotation.Flatten(known), flattened));
+            if (equivalent != null)
+                _knowledgeBase.Add(theorem, (new TheoremInferenceData(ReformulatedTheorem), new[] { equivalent }));
+        }

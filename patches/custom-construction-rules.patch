+                }
+                case "isogonal": {
+                    layout=LooseObjectLayout.Quadrilateral;
+                    var l=Make(InternalAngleBisector,A,B,C);var r=Make(ReflectionInLine,l,P);var x=Make(Isogonal,P,A,B,C);

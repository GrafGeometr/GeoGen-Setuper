+        }
+
+        private class InvalidTracer : IInvalidInferenceTracer
+        {
+            public List<string> Errors {get;}=new();
+            public void MarkInvalidInferrence(Configuration c,Theorem theorem,InferenceRule rule,Theorem[] negatives,Theorem[] positives)
+            {
+                if(rule is LoadedInferenceRule loaded && loaded.RelativeFileName.Contains("AdditionalCustomConstructions"))
+                    Errors.Add(rule.ToString());
+            }
+        }
+    }

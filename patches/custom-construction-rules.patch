index 0000000..5893e2c
--- /dev/null
+++ b/Source/Library/GeoGen.TheoremProver/TheoremNotation.cs
@@ -0,0 +1,18 @@
+using GeoGen.Core;
+using GeoGen.Utilities;
+
+namespace GeoGen.TheoremProver
+{
+    internal static class TheoremNotation
+    {
+        internal static Theorem Flatten(Theorem theorem)
+        {
+            // EqualObjects operands must each remain one configuration object.
+            if (theorem.Type == TheoremType.EqualObjects)
+                return theorem;
+            var identity = theorem.GetInnerConfigurationObjects().GetDefiningObjects()
+                .Distinct().ToDictionary(obj => obj, obj => obj);
+            return theorem.Remap(identity, flattenObjectsFromPoints: true);
+        }
+    }
+}

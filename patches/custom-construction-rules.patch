+                    objects.AddRange(new[]{o,l,x});targets.AddRange(new[]{Inc(o,l),Inc(x,l),Col(A,o,x)});wrong=Inc(o,Make(LineFromPoints,B,C));break;
+                }
+                case "gergonne": {
+                    var t=Make(IncircleTangentPoint,A,B,C);var u=Make(IncircleTangentPoint,B,A,C);var x=Make(Gergonne,A,B,C);
+                    objects.AddRange(new[]{t,u,x});targets.AddRange(new[]{Col(A,t,x),Col(B,u,x)});wrong=Col(B,t,x);break;
+                }
+                case "nagel": {
+                    var e=Make(Excenter,A,B,C);var t=Make(PerpendicularProjectionOnLineFromPoints,e,B,C);var x=Make(Nagel,A,B,C);
+                    objects.AddRange(new[]{e,t,x});targets.Add(Col(A,t,x));wrong=Col(B,t,x);break;
+                }
+                case "lemoine": {
+                    var l=Make(Symedian,A,B,C);var t=Make(SymedianEnd,A,B,C);var x=Make(Lemoine,A,B,C);
+                    objects.AddRange(new[]{l,t,x});targets.AddRange(new[]{Inc(x,l),Col(A,t,x)});wrong=Inc(x,Make(Median,A,B,C));break;
+                }
+                case "quadrilateral-centroid": {
+                    layout=LooseObjectLayout.Quadrilateral;
+                    var m=Make(Midpoint,A,B);var n=Make(Midpoint,C,D);var t=Make(Centroid,A,B,C);var x=Make(QuadrilateralCentroid,A,B,C,D);

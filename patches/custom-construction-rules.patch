+            data.InconstructibleObject.Should().BeNull(rule.ToString());
+            (data.Duplicates == default).Should().BeTrue(rule.ToString());
+            kernel.Get<IGeometricTheoremVerifier>().IsTrueInAllPictures(pictures, rule.Conclusion).Should().BeTrue(rule.ToString());
+        }
+
+        public static IEnumerable<string> Scenarios => new[] { "contact", "contact-projection", "contact-lengths", "humpty", "dumpty", "ho", "tangents",

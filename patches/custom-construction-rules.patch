+                    var provedByNotation = normalizationHelper.ProvedTheorems.Select(TheoremNotation.Flatten).ToHashSet();
+                    return theoremsToProve.AllObjects.Where(theorem => provedByNotation.Contains(TheoremNotation.Flatten(theorem)))
+                        .ToReadOnlyHashSet();
+                }
 
                 #region Inference rule applier call
 

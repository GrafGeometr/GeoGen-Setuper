+/// <summary>Native counterparts of every alternative in Extending Functions.functions (original is excluded).</summary>
+public static class ConditionalWeakeningCatalog
+{
+    private static readonly WeakParameter[] One={WeakParameter.Coordinate},Two={WeakParameter.Coordinate,WeakParameter.Coordinate},Angle={WeakParameter.Angle},Radius={WeakParameter.Radius};
+    private static Point Direction(Line l)=>new(-l.B,l.A);
+    private static Point OnLine(Line l,double t)=>new Point(-l.A*l.C,-l.B*l.C)+Direction(l)*t;
+    private static double Along(Line l,Point p)=>p.X*(-l.B)+p.Y*l.A;
+    private static Point Unit(Point p)=>p/p.DistanceToOrigin;
+    private static Func<Picture,Line> Line(Func<Picture,Point> a,Func<Picture,Point> b)=>p=>new Line(a(p),b(p));
+    private static Func<Picture,Point> Mid(Func<Picture,Point> a,Func<Picture,Point> b)=>p=>(a(p)+b(p))/2;
+    private static Func<Picture,Point> Center(Func<Picture,Circle> c)=>p=>c(p).Center;
+    private static Func<Picture,Line> Perp(Func<Picture,Point> a,Func<Picture,Line> l)=>p=>l(p).PerpendicularLineThroughPoint(a(p));
+    private static Func<Picture,Line> Parallel(Func<Picture,Point> a,Func<Picture,Line> l)=>p=>new Line(a(p),a(p)+Direction(l(p)));
+    private static Func<Picture,Line> Bisector(Func<Picture,Point> vertex,Func<Picture,Point> b,Func<Picture,Point> c,bool external=false)=>p=>{
+        var v=vertex(p);var u=Unit(b(p)-v);var w=Unit(c(p)-v);return new Line(v,v+u+(external ? -1 : 1)*w);
+    };
+    private static Func<Picture,Line> Symmedian(Func<Picture,Point> a,Func<Picture,Point> b,Func<Picture,Point> c)=>p=>{
+        var x=a(p);var y=b(p);var z=c(p);var ab=MetricRelations.SquaredDistance(x,y);var ac=MetricRelations.SquaredDistance(x,z);
+        return new Line(x,(y*ac+z*ab)/(ab+ac));
+    };
+    private static Func<Picture,Circle> Circum(Func<Picture,Point> a,Func<Picture,Point> b,Func<Picture,Point> c)=>p=>new Circle(a(p),b(p),c(p));
+    private static Func<Picture,Point> Incenter(Func<Picture,Point> a,Func<Picture,Point> b,Func<Picture,Point> c)=>p=>{
+        var x=a(p);var y=b(p);var z=c(p);var u=y.DistanceTo(z);var v=x.DistanceTo(z);var w=x.DistanceTo(y);return (x*u+y*v+z*w)/(u+v+w);
+    };
+    private static ConditionalWeakening PointOn(string name,Func<Picture,Line> line)=>new(name,One,
+        (p,t)=>OnLine(line(p),t[0]),(p,o)=>new[]{Along(line(p),(Point)o)});
+    private static ConditionalWeakening PointOn(string name,Func<Picture,Circle> circle)=>new(name,Angle,
+        (p,t)=>circle(p).Center+new Point(Math.Cos(t[0]),Math.Sin(t[0]))*circle(p).Radius,
+        (p,o)=>new[]{Math.Atan2(((Point)o).Y-circle(p).Center.Y,((Point)o).X-circle(p).Center.X)});
+    private static ConditionalWeakening FreePoint()=>new("arbitrary point",Two,(p,t)=>new Point(t[0],t[1]),(p,o)=>new[]{((Point)o).X,((Point)o).Y});
+    private static ConditionalWeakening Through(string name,Func<Picture,Point> point)=>new(name,Angle,
+        (p,t)=>new Line(point(p),point(p)+new Point(Math.Cos(t[0]),Math.Sin(t[0]))),
+        (p,o)=>new[]{Math.Atan2(((Line)o).A,-((Line)o).B)});
+    private static ConditionalWeakening ParallelTo(string name,Func<Picture,Line> line)=>new(name,One,
+        (p,t)=>{var l=line(p);var q=new Point(-l.A*(l.C+t[0]),-l.B*(l.C+t[0]));return new Line(q,q+Direction(l));},
+        (p,o)=>{var l=line(p);var v=(Line)o;return new[]{v.C*(v.A*l.A+v.B*l.B)-l.C};});
+    private static ConditionalWeakening Centered(string name,Func<Picture,Point> center)=>new(name,Radius,
+        (p,t)=>new Circle(center(p),t[0]),(p,o)=>new[]{((Circle)o).Radius});
+    private static ConditionalWeakening CircleThrough(string name,Func<Picture,Point> point)=>new(name,Two,
+        (p,t)=>{var c=new Point(t[0],t[1]);return new Circle(c,c.DistanceTo(point(p)));},
+        (p,o)=>new[]{((Circle)o).Center.X,((Circle)o).Center.Y});
+    private static ConditionalWeakening CircleOn(string name,Func<Picture,Line> centers,Func<Picture,Point> through)=>new(name,One,
+        (p,t)=>{var c=OnLine(centers(p),t[0]);return new Circle(c,c.DistanceTo(through(p)));},
+        (p,o)=>new[]{Along(centers(p),((Circle)o).Center)});
+    private static ConditionalWeakening TangentOn(string name,Func<Picture,Line> centers,Func<Picture,Line> tangent)=>new(name,One,
+        (p,t)=>{var c=OnLine(centers(p),t[0]);return new Circle(c,c.DistanceTo(c.Project(tangent(p))));},
+        (p,o)=>new[]{Along(centers(p),((Circle)o).Center)});

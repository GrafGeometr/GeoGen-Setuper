+using System.Diagnostics;
+using GeoGen.Constructor;
+using GeoGen.Core;
+namespace GeoGen.ProblemGenerator;
+
+public sealed class ConditionalWeakeningEvidence
+{
+    public string Object { get; init; }
+    public string Construction { get; init; }
+    public string[] Arguments { get; init; }
+    public int Variant { get; init; }
+    public string Description { get; init; }
+    public int Dimension { get; init; }
+    public string Status { get; set; }
+    public int Samples { get; set; }
+    public int ChangedDefinitionSamples { get; set; }
+    public int IndependentBatches { get; set; }
+    public double[][] Coordinates { get; set; }
+    public double? ConditionResidual { get; set; }
+    public double? GoalResidual { get; set; }
+    public long Draws { get; set; }
+    public string Message { get; set; }
+}
+public sealed record ConditionalExtensionResult(string Status,int TotalVariants,int CompletedVariants,int DefinitionsWithoutAlternatives,long Draws,IReadOnlyList<ConditionalWeakeningEvidence> Variants);
+internal sealed class VariantDeadlineException:Exception { }
+
+/// <summary>One relaxed definition at a time, with the SAME extra premise. Never accepts an unsampled weakening.</summary>
+public sealed class ConditionalExtender
+{
+    private readonly IGeometryConstructor _constructor;
+    public List<ConditionalWeakeningEvidence> Evidence { get; }=new();
+    public int TotalVariants { get; private set; }
+    public int DefinitionsWithoutAlternatives { get; private set; }
+    private long _originalDraws;
+    public ConditionalExtender(IGeometryConstructor constructor)=>_constructor=constructor;
+    public ConditionalExtensionResult Check(Configuration configuration,Theorem condition,Theorem goal,IReadOnlyList<ConditionSample> original,
+        IReadOnlyList<ConditionSample> generic,Func<ConfigurationObject,string> name,Action checkDeadline,int variantMilliseconds=1000)
+    {
+        var plans=configuration.ConstructedObjects.Select(o=>(obj:o,variants:ConditionalWeakeningCatalog.For(o))).ToArray();
+        TotalVariants=plans.Sum(p=>p.variants.Length);DefinitionsWithoutAlternatives=plans.Count(p=>p.variants.Length==0);
+        var originalSampler=new ConditionalSampler(_constructor,configuration,new ConditionalSearchSettings(),checkDeadline);
+        foreach(var (obj,variants) in plans)for(var index=0;index<variants.Length;index++){
+            checkDeadline();var variant=variants[index];
+            var evidence=new ConditionalWeakeningEvidence{Object=name(obj),Construction=obj.Construction.Name,Arguments=obj.PassedArguments.FlattenedList.Select(name).ToArray(),
+                Variant=index,Description=variant.Description,Dimension=2+variant.Parameters.Length,Status="inconclusive"};Evidence.Add(evidence);
+            // A purported weakening must actually contain the original definition, on both constrained and generic inputs.
+            var undefined=false;
+            foreach(var sample in original.Concat(generic)){
+                checkDeadline();var admits=AdmitsOriginal(variant,sample.Picture,sample.Picture.Get(obj));
+                if(admits==null){evidence.Message="Weakening locus is undefined on an original sample";undefined=true;break;}
+                if(admits==false)throw new InvalidOperationException($"Weakening catalog does not contain original {name(obj)}={obj.Construction.Name}, variant {index}: {variant.Description}");
+            }
+            if(undefined)continue;
+            var local=Stopwatch.StartNew();
+            void Deadline(){checkDeadline();if(local.ElapsedMilliseconds>=variantMilliseconds)throw new VariantDeadlineException();}
+            var settings=new ConditionalSearchSettings{Samples=8,Starts=80,Iterations=60};
+            var sampler=new ConditionalSampler(_constructor,configuration,settings,Deadline,obj,variant);
+            var samples=new List<double[]>();var disproved=false;var unknown=false;
+            try {
+                for(var batch=0;batch<2;batch++){
+                    var seed=ConditionalSearchEngine.StableSeed("extend|"+new OutputFormatter(configuration.AllObjects).FormatConfiguration(configuration)+"|"+name(obj)+"|"+index+"|"+batch+"|"+new OutputFormatter(configuration.AllObjects).FormatTheorem(condition));
+                    var valid=0;
+                    foreach(var sample in sampler.EnumerateOn(condition,new Random(seed))){
+                        var residual=ConditionalPredicate.Residual(sample.Picture,goal);
+                        if(!residual.HasValue)continue;
+                        evidence.Samples++;valid++;
+                        if(Math.Abs(residual.Value)>1e-5){
+                            var originalAtShape=originalSampler.Draw(sample.Parameters[0],sample.Parameters[1]);_originalDraws=originalSampler.Draws;
+                            if(originalAtShape!=null && ConditionalPredicate.Holds(originalAtShape.Picture,condition) &&
+                                ConditionalPredicate.Residual(originalAtShape.Picture,goal) is double originalResidual && Math.Abs(originalResidual)>1e-5){
+                                evidence.Status="original-counterexample";evidence.Coordinates=new[]{originalAtShape.Parameters};evidence.GoalResidual=originalResidual;
+                                evidence.ConditionResidual=ConditionalPredicate.Residual(originalAtShape.Picture,condition);evidence.Draws=sampler.Draws;
+                                return Result("counterexample");
+                            }
+                            evidence.Status="counterexample";evidence.Coordinates=new[]{sample.Parameters};
+                            evidence.ConditionResidual=ConditionalPredicate.Residual(sample.Picture,condition);evidence.GoalResidual=residual;
+                            disproved=true;break;
+                        }
+                        if(Math.Abs(residual.Value)>2e-8)unknown=true;
+                        GeoGen.AnalyticGeometry.IAnalyticObject expected;
+                        try{expected=_constructor.Construct(sample.Picture,obj,false);}
+                        catch(GeoGen.AnalyticGeometry.AnalyticException){expected=null;}
+                        if(expected==null || ConditionalWeakening.Difference(expected,sample.Picture.Get(obj))>1e-5)evidence.ChangedDefinitionSamples++;
+                        samples.Add(sample.Parameters);
+                    }
+                    if(disproved)break;
+                    if(valid<settings.Samples){unknown=true;break;}
+                    evidence.IndependentBatches++;
+                }
+                if(!disproved&&!unknown&&evidence.IndependentBatches==2&&evidence.ChangedDefinitionSamples>=2){
+                    evidence.Status="generalized";evidence.Coordinates=samples.ToArray();evidence.Draws=sampler.Draws;
+                    return Result("rejected");
+                }
+                if(!disproved)evidence.Message="Insufficient defined regular samples or ambiguous residuals; weakening has not been decided";
+            } catch(VariantDeadlineException){evidence.Message="Per-variant sampling budget exhausted";}
+            finally{evidence.Draws=sampler.Draws;}
+        }
+        return Result(Evidence.Any(e=>e.Status=="inconclusive") ? "inconclusive" : "accepted");
+    }
+    /// <summary>Null denotes an undefined geometric locus; false denotes a catalog mismatch.</summary>
+    public static bool? AdmitsOriginal(ConditionalWeakening variant,Picture picture,GeoGen.AnalyticGeometry.IAnalyticObject original)
+    {
+        try{return variant.Contains(picture,original);}
+        catch(Exception error) when(error is GeoGen.AnalyticGeometry.AnalyticException or ArithmeticException){return null;}
+    }
+    public ConditionalExtensionResult Result(string status)=>new(status,TotalVariants,Evidence.Count(e=>e.Status is "counterexample" or "generalized"),DefinitionsWithoutAlternatives,Evidence.Sum(e=>e.Draws)+_originalDraws,Evidence);
+}

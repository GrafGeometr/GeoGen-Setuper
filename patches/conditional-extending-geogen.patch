+using System.Diagnostics;
+using System.Text.Json;
+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.Infrastructure;
+using GeoGen.ProblemGenerator;
+using Ninject;
+namespace GeoGen.MainLauncher;
+internal static class ConditionalExtendingCommand
+{
+    public static void Run(string path,int? geoMilliseconds=null)
+    {
+        var clock=Stopwatch.StartNew();object result;ConditionalExtender extender=null;
+        try {
+            var input=geoMilliseconds.HasValue ? ReadGeo(path,geoMilliseconds.Value) : JsonDocument.Parse(File.ReadAllText(path));
+            using(input){var data=input.RootElement;
+                var configurationText=data.GetProperty("configuration").GetString();var conditionText=data.GetProperty("condition").GetString();var goalText=data.GetProperty("theorem").GetString();
+                var milliseconds=data.TryGetProperty("milliseconds",out var ms)?ms.GetInt32():15000;
+                if(milliseconds<1||milliseconds>3600000)throw new ArgumentException("Invalid conditional extending budget");
+                void Deadline(){if(clock.Elapsed.TotalMilliseconds>=milliseconds)throw new TimeoutException();}
+                var (configuration,names)=Parser.ParseConfiguration(configurationText.Split('\n'));
+                var condition=Parser.ParseTheorem(conditionText,names,false);var goal=Parser.ParseTheorem(goalText,names,false);
+                if(condition.Equals(goal)){Print(new{status="rejected",message="Conclusion repeats the condition"});return;}
+                using var kernel=NinjectUtilities.CreateKernel().AddConstructor();var constructor=kernel.Get<IGeometryConstructor>();
+                var settings=new ConditionalSearchSettings{Samples=8};var sampler=new ConditionalSampler(constructor,configuration,settings,Deadline);
+                var random=new Random(ConditionalSearchEngine.StableSeed("verify|"+configurationText+"|"+conditionText+"|"+goalText));
+                var roots=sampler.On(condition,random);
+                if(roots.Count<8){Print(new{status="inconclusive",message="Insufficient independent samples satisfying the condition",samples=roots.Count});return;}
+                var counter=roots.FirstOrDefault(r=>!ConditionalPredicate.Holds(r.Picture,goal));
+                if(counter!=null){Print(new{status="counterexample",message="Conclusion fails under the condition",coordinates=counter.Parameters,conditionResidual=ConditionalPredicate.Residual(counter.Picture,condition),goalResidual=ConditionalPredicate.Residual(counter.Picture,goal)});return;}
+                var generic=sampler.Generic(random,12);var counters=ConditionalSearchEngine.Counters(generic,condition,goal);
+                if(counters.Length<2){Print(new{status="inconclusive",message="Essentiality of the extra condition is not confirmed"});return;}
+                extender=new ConditionalExtender(constructor);
+                var perVariant=data.TryGetProperty("variantMilliseconds",out var per)?per.GetInt32():Math.Max(250,Math.Min(2000,milliseconds/Math.Max(1,configuration.ConstructedObjects.Sum(o=>ConditionalWeakeningCatalog.For(o).Length))));
+                if(perVariant<1||perVariant>3600000)throw new ArgumentException("Invalid per-variant budget");
+                var extension=extender.Check(configuration,condition,goal,roots,generic,o=>names.First(n=>n.Value.Equals(o)).Key,Deadline,perVariant);
+                result=new{status=extension.Status,message=extension.Status switch {"rejected"=>"Conclusion survives a weaker definition with the same condition","inconclusive"=>"Some weakenings remain undecided; no acceptance is claimed","counterexample"=>"Original conclusion fails on a newly found conditional sample",_=>"All catalog weakenings refuted under the same condition"},
+                    truth="conditioned-sampled-valid",samples=roots.Count,genericCounterexamples=counters.Length,counterexamples=counters,conditionSamples=roots.Select(r=>r.Parameters).ToArray(),
+                    weakening=extension,seconds=clock.Elapsed.TotalSeconds,notice="Finite numerical conditional weakening checks, not a formal proof or exhaustive component analysis"};
+            }
+        } catch(TimeoutException){result=new{status="timeout",message="Conditional Extending exceeded the shared deadline",weakening=extender?.Result("timeout")};}
+        catch(Exception error){result=new{status="error",message=error.Message,weakening=extender?.Result("error")};}
+        Print(result);
+    }
+    private static void Print(object value)=>Console.WriteLine(JsonSerializer.Serialize(value,new JsonSerializerOptions(ConditionalSearchSettings.JsonOptions){PropertyNamingPolicy=JsonNamingPolicy.CamelCase}));
+    private static JsonDocument ReadGeo(string path,int milliseconds)
+    {
+        var config=new List<string>();string condition=null,goal=null;
+        foreach(var raw in File.ReadLines(path)){
+            var comment=raw.TrimStart();if(!comment.StartsWith('!'))continue;var line=comment[1..].Trim();
+            if(line.StartsWith("Assume:")){
+                if(condition!=null)throw new ArgumentException("Exactly one condition is supported");
+                condition=line[7..].Trim();if(condition.EndsWith(" - assumption"))condition=condition[..^13];
+            }else if(line.StartsWith("Triangle:") || System.Text.RegularExpressions.Regex.IsMatch(line,@"^\w+\s*=\s*\w+\("))config.Add(line.Replace("{","").Replace("}",""));
+            else if(Enum.TryParse<TheoremType>(line.Split(':')[0],out _))goal=line.Split(" - total ranking")[0];
+        }
+        if(condition==null||goal==null||config.Count==0)throw new ArgumentException("Incomplete conditional .geo statement");
+        return JsonDocument.Parse(JsonSerializer.Serialize(new{configuration=string.Join('\n',config),condition,theorem=goal,milliseconds}));
+    }
+}

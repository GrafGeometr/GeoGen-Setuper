+[TestFixture]
+public class ConditionalWeakeningCatalogTest
+{
+    private IKernel _kernel;
+    [OneTimeSetUp]public void Setup()=>_kernel=NinjectUtilities.CreateKernel().AddConstructor();
+    [OneTimeTearDown]public void Cleanup()=>_kernel.Dispose();
+    public static IEnumerable<string> Names()=>Constructions.GetPredefinedConstructions().Cast<Construction>().Concat(Constructions.GetComposedConstructions()).Select(c=>c.Name);
+    [TestCaseSource(nameof(Names))]
+    public void Every_relaxation_contains_the_original_on_independent_generic_pictures(string name)
+    {
+        var construction=Constructions.GetPredefinedConstructions().Cast<Construction>().Concat(Constructions.GetComposedConstructions()).Single(c=>c.Name==name);
+        var args=construction.Signature.ObjectTypes.Select(t=>(ConfigurationObject)new LooseConfigurationObject(t)).ToArray();
+        var obj=new ConstructedConfigurationObject(construction,args);var variants=ConditionalWeakeningCatalog.For(obj);
+        var random=new Random(ConditionalSearchEngine.StableSeed(name));var successes=0;
+        Point Point()=>new(-2+4*random.NextDouble(),-2+4*random.NextDouble());
+        for(var attempt=0;attempt<30&&successes<3;attempt++){
+            var picture=new Picture();
+            foreach(var arg in args){IAnalyticObject value=arg.ObjectType switch {
+                ConfigurationObjectType.Point=>Point(),ConfigurationObjectType.Line=>new Line(Point(),Point()),ConfigurationObjectType.Circle=>new Circle(Point(),.3+2*random.NextDouble()),_=>throw new Exception()};
+                picture.TryAdd(arg,value,out _);
+            }
+            IAnalyticObject original;
+            try{original=_kernel.Get<IGeometryConstructor>().Construct(picture,obj,false);if(original==null)continue;}
+            catch(AnalyticException){continue;}
+            foreach(var variant in variants)Assert.That(variant.Contains(picture,original),Is.True,$"{name}: {variant.Description}; original={original}");
+            successes++;
+        }
+        Assert.That(successes,Is.EqualTo(3));
+    }
+}

+    public static ConditionalWeakening[] For(ConstructedConfigurationObject obj)=>For(obj.Construction.Name,obj.PassedArguments.FlattenedList);
+    public static ConditionalWeakening[] For(string name,IReadOnlyList<ConfigurationObject> args)
+    {
+        Func<Picture,Point> P(int i)=>p=>(Point)p.Get(args[i]);
+        Func<Picture,Line> L(int i)=>p=>(Line)p.Get(args[i]);
+        Func<Picture,Circle> C(int i)=>p=>(Circle)p.Get(args[i]);
+        var a=P(0);var b=P(1);var c=P(2);var d=P(3);
+        var ab=Line(a,b);var bc=Line(b,c);var ac=Line(a,c);
+        var ma=Mid(b,c);var midAB=Mid(a,b);var midAC=Mid(a,c);
+        var cc=Circum(a,b,c);var o=Center(cc);Func<Picture,Point> h=p=>a(p)+b(p)+c(p)-2*o(p);
+        var inc=Incenter(a,b,c);var median=Line(a,ma);var altitude=Perp(a,bc);var midline=Line(midAB,midAC);
+        var internalA=Bisector(a,b,c);var externalA=Bisector(a,b,c,true);var sym=Symmedian(a,b,c);
+        var radiusLine=Line(a,o);
+        Func<Picture,Circle> nine=p=>new Circle(midAB(p),ma(p),midAC(p));
+        ConditionalWeakening[] Intersections(Func<Picture,Line> l,Func<Picture,Line> m)=>new[]{PointOn("point on first line",l),PointOn("point on second line",m)};
+        ConditionalWeakening[] Middle(Func<Picture,Line> l)=>new[]{PointOn("point on defining cevian",l),PointOn("point on midline",midline)};
+        ConditionalWeakening[] End(Func<Picture,Line> l)=>new[]{PointOn("point on defining cevian",l),PointOn("point on opposite side",bc)};
+        ConditionalWeakening[] TwoLine(Func<Picture,Line> l)=>new[]{Through("line through defining point",a),ParallelTo("line parallel to defining direction",l)};
+        return name switch {
+            "PerpendicularLine"=>TwoLine(Perp(a,L(1))),
+            "IncircleTangentPoint"=>new[]{PointOn("point on opposite side",bc),PointOn("point on incircle",p=>new Circle(inc(p),inc(p).DistanceTo(inc(p).Project(bc(p)))))},
+            "FeuerbachPoint"=>new[]{PointOn("point on incircle",p=>new Circle(inc(p),inc(p).DistanceTo(inc(p).Project(bc(p))))),PointOn("point on nine point circle",nine)},
+            "PonceletPoint"=>new[]{PointOn("point on ABC nine point circle",nine),PointOn("point on ABD nine point circle",p=>new Circle(midAB(p),Mid(b,d)(p),Mid(a,d)(p))),PointOn("point on ACD nine point circle",p=>new Circle(midAC(p),Mid(c,d)(p),Mid(a,d)(p))),PointOn("point on BCD nine point circle",p=>new Circle(ma(p),Mid(c,d)(p),Mid(b,d)(p)))},
+            "QuadrilateralCentroid"=>new[]{PointOn("point on first bimedian",Line(midAB,Mid(c,d))),PointOn("point on second bimedian",Line(midAC,Mid(b,d))),PointOn("point on third bimedian",Line(Mid(a,d),ma))},
+            "HOPoint"=>new[]{PointOn("point on opposite side",bc)},
+            "FPC"=>Fpc(h,ma,p=>a(p).Project(bc(p))),
+            "CenterOfCircle" or "Harmonic" or "Gergonne" or "Nagel" or "Antigonal" or "Isotomic" or "Isogonal"=>new[]{FreePoint()},
+            "InversionOfPoint"=>new[]{PointOn("point on inversion ray",Line(a,Center(C(1))))},
+            "CenterOfNegativeHomothety" or "CenterOfPositiveHomothety"=>new[]{PointOn("point on line of centers",Line(Center(C(0)),Center(C(1))))},
+            "Lemoine"=>new[]{PointOn("point on B symmedian",Symmedian(b,a,c)),PointOn("point on A symmedian",sym),PointOn("point on C symmedian",Symmedian(c,a,b))},
+            "TangentLinesIntersection"=>new[]{PointOn("point on opposite perpendicular bisector",Perp(ma,bc))},
+            "DumptyPoint"=>new[]{PointOn("point on A symmedian",sym),PointOn("point on OBC circle",Circum(o,b,c))},
+            "HumptyPoint"=>new[]{PointOn("point on A median",median),PointOn("point on HBC circle",Circum(h,b,c))},
+            "RadiusLineMiddle"=>Middle(radiusLine),"RadiusLineEnd"=>End(radiusLine),"RadiusLine"=>new[]{Through("line through vertex",a)},
+            "ExternalBisectorMiddle"=>Middle(externalA),"ExternalBisectorEnd"=>End(externalA),
+            "SymedianMiddle"=>Middle(sym),"SymedianEnd"=>End(sym),"Symedian"=>new[]{Through("line through vertex",a)},
+            "MedianMiddle"=>Middle(median),"HeightMiddle"=>Middle(altitude),"BisectorMiddle"=>Middle(internalA),"BisectorEnd"=>End(internalA),
+            "Centroid"=>new[]{PointOn("point on A median",median),PointOn("point on B median",Line(b,midAC)),PointOn("point on C median",Line(c,midAB))},
+            "CircleWithCenterThroughPoint"=>new[]{Centered("circle with given center",a),CircleThrough("circle through given point",b)},
+            "CircleWithDiameter"=>new[]{CircleOn("center on AB through A",ab,a),CircleOn("center on AB through B",ab,b),Centered("circle with midpoint center",midAB),CircleOn("center on perpendicular bisector through A",Perp(midAB,ab),a)},
+            "Circumcenter"=>new[]{PointOn("point on AB perpendicular bisector",Perp(midAB,ab)),PointOn("point on BC perpendicular bisector",Perp(ma,bc)),PointOn("point on AC perpendicular bisector",Perp(midAC,ac))},
+            "Circumcircle"=>new[]{Centered("circle with circumcenter",o),CircleOn("circle through AB",Perp(midAB,ab),a),CircleOn("circle through BC",Perp(ma,bc),b),CircleOn("circle through AC",Perp(midAC,ac),c)},
+            "Excenter"=>new[]{PointOn("point on A internal bisector",internalA),PointOn("point on C external bisector",Bisector(c,a,b,true)),PointOn("point on B external bisector",Bisector(b,a,c,true))},

+using GeoGen.AnalyticGeometry;
+using GeoGen.Constructor;
+using GeoGen.Core;
+namespace GeoGen.ProblemGenerator;
+
+public enum WeakParameter { Coordinate, Angle, Radius }
+
+/// <summary>A relaxed definition with explicit free coordinates; descendants retain their definitions.</summary>
+public sealed class ConditionalWeakening
+{
+    public string Description { get; }
+    public WeakParameter[] Parameters { get; }
+    public Func<Picture,double[],IAnalyticObject> Draw { get; }
+    public Func<Picture,IAnalyticObject,double[]> OriginalCoordinates { get; }
+    public ConditionalWeakening(string description,WeakParameter[] parameters,Func<Picture,double[],IAnalyticObject> draw,Func<Picture,IAnalyticObject,double[]> coordinates)
+        =>(Description,Parameters,Draw,OriginalCoordinates)=(description,parameters,draw,coordinates);
+    public static double Difference(IAnalyticObject a,IAnalyticObject b) => (a,b) switch {
+        (Point x,Point y)=>x.DistanceTo(y),
+        (Circle x,Circle y)=>Math.Max(x.Center.DistanceTo(y.Center),Math.Abs(x.Radius-y.Radius)),
+        (Line x,Line y)=>Math.Min(Math.Max(Math.Max(Math.Abs(x.A-y.A),Math.Abs(x.B-y.B)),Math.Abs(x.C-y.C)),
+                                Math.Max(Math.Max(Math.Abs(x.A+y.A),Math.Abs(x.B+y.B)),Math.Abs(x.C+y.C))),
+        _=>double.PositiveInfinity
+    };
+    public bool Contains(Picture p,IAnalyticObject original) => Difference(original,Draw(p,OriginalCoordinates(p,original)))<1e-6;
+}

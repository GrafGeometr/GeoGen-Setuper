diff --git a/Source/Library/GeoGen.ProblemGenerator/ConditionalLayout.cs b/Source/Library/GeoGen.ProblemGenerator/ConditionalLayout.cs
new file mode 100644
index 0000000..cec1292
--- /dev/null
+++ b/Source/Library/GeoGen.ProblemGenerator/ConditionalLayout.cs
@@ -0,0 +1,55 @@
+using GeoGen.AnalyticGeometry;
+using GeoGen.Core;
+namespace GeoGen.ProblemGenerator;
+
+/// <summary>Similarity-normalized charts. Parameters are serialized as the witness.</summary>
+public static class ConditionalLayout
+{
+    public static int Dimension(LooseObjectLayout layout)=>layout switch {
+        LooseObjectLayout.LineSegment or LooseObjectLayout.LineAndPoint=>0,
+        LooseObjectLayout.RightTriangle=>1,
+        LooseObjectLayout.Triangle or LooseObjectLayout.LineAndTwoPoints=>2,
+        LooseObjectLayout.CyclicQuadrilateral=>3,
+        LooseObjectLayout.Quadrilateral=>4,
+        _=>throw new ArgumentException("Unsupported conditional layout: "+layout)};
+    public static double[] Start(LooseObjectLayout layout,Random random) {
+        double R()=>random.NextDouble();
+        return layout switch {
+            LooseObjectLayout.Triangle=>new[]{-.6+2.2*R(),.2+1.7*R()},
+            LooseObjectLayout.RightTriangle=>new[]{.2+1.7*R()},
+            LooseObjectLayout.Quadrilateral=>new[]{.3+R(),.4+R(),-.5+R(),.4+R()},
+            LooseObjectLayout.CyclicQuadrilateral=>new[]{2*R()-1,2*R()-1,2*R()-1},
+            LooseObjectLayout.LineAndTwoPoints=>new[]{-1+2*R(),(R()<.5?-1:1)*(.2+2*R())},
+            _=>new double[Dimension(layout)]};
+    }
+    public static IAnalyticObject[] Objects(LooseObjectLayout layout,double[] p) {
+        if(p.Length!=Dimension(layout)||p.Any(v=>!double.IsFinite(v)||Math.Abs(v)>6))return null;
+        var a=new Point(0,0);var b=new Point(1,0);
+        switch(layout){
+            case LooseObjectLayout.LineSegment:return new IAnalyticObject[]{a,b};
+            case LooseObjectLayout.LineAndPoint:return new IAnalyticObject[]{new Line(a,b),new Point(0,1)};
+            case LooseObjectLayout.LineAndTwoPoints:
+                if(Math.Abs(p[1])<.06)return null;
+                return new IAnalyticObject[]{new Line(a,b),new Point(0,1),new Point(p[0],p[1])};
+            case LooseObjectLayout.Triangle:
+                if(p[0]<-2||p[0]>3||p[1]<.06||p[1]>3)return null;
+                return new IAnalyticObject[]{a,b,new Point(p[0],p[1])};
+            case LooseObjectLayout.RightTriangle:
+                if(p[0]<.06||p[0]>3)return null;
+                return new IAnalyticObject[]{a,b,new Point(0,p[0])};
+            case LooseObjectLayout.Quadrilateral:
+                var q=new[]{a,b,new Point(p[0],p[1]),new Point(p[2],p[3])};
+                for(var i=0;i<4;i++) {
+                    var x=q[i];var y=q[(i+1)%4];var z=q[(i+2)%4];
+                    if((y.X-x.X)*(z.Y-y.Y)-(y.Y-x.Y)*(z.X-y.X)<1e-5)return null;
+                }
+                return q.Cast<IAnalyticObject>().ToArray();
+            case LooseObjectLayout.CyclicQuadrilateral:
+                var weights=p.Select(Math.Exp).Append(1).ToArray();var sum=weights.Sum();var angle=0.0;
+                var points=new IAnalyticObject[4];
+                for(var i=0;i<4;i++){points[i]=new Point(Math.Cos(angle),Math.Sin(angle));angle+=2*Math.PI*weights[i]/sum;}
+                return points;
+            default:throw new ArgumentException("Unsupported layout");
+        }
+    }
+}

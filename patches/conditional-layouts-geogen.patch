+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.ProblemGenerator;
+using NUnit.Framework;
+using Ninject;
+namespace GeoGen.ConfigurationGenerator.Tests;
+[TestFixture]
+public class ConditionalLayoutsTest
+{
+    [TestCase("Triangle: A, B, C", "EqualLineSegments: A, B, B, C",2)]
+    [TestCase("RightTriangle: A, B, C", "EqualLineSegments: A, B, A, C",1)]
+    [TestCase("Quadrilateral: A, B, C, D", "EqualLineSegments: A, B, B, C",4)]
+    [TestCase("CyclicQuadrilateral: A, B, C, D", "EqualLineSegments: A, B, B, C",3)]
+    [TestCase("LineAndTwoPoints: l, A, B", "ParallelLines: l, [A, B]",2)]
+    public void Samples_every_nonrigid_layout(string initial,string premise,int dimension)
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var (configuration,names)=Parser.ParseConfiguration(new[]{initial});
+            var condition=Parser.ParseTheorem(premise,names,false);
+            var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),configuration,new ConditionalSearchSettings{Starts=160});
+            Assert.That(sampler.Dimension,Is.EqualTo(dimension));
+            Assert.That(sampler.Generic(new Random(17),8).Count,Is.EqualTo(8));
+            var roots=sampler.On(condition,new Random(61));
+            Assert.That(roots.Count,Is.EqualTo(8));
+            Assert.That(roots.All(r=>ConditionalPredicate.Holds(r.Picture,condition)),Is.True);
+            Assert.That(roots.All(r=>r.Parameters.Length==dimension),Is.True);
+        }
+    }
+    [TestCase("LineSegment: A, B")]
+    [TestCase("LineAndPoint: l, A")]
+    public void Rigid_layouts_are_constructible_without_shape_freedom(string initial)
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var (configuration,names)=Parser.ParseConfiguration(new[]{initial});
+            var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),configuration,new ConditionalSearchSettings());
+            Assert.That(sampler.Dimension,Is.Zero);Assert.That(sampler.Generic(new Random(61),8).Count,Is.EqualTo(8));
+        }
+    }
+    [Test]
+    public void User_quadrilateral_story_is_constructible()
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var (configuration,names)=Parser.ParseConfiguration(new[]{"Quadrilateral: A, B, C, D",
+                "P = IntersectionOfLinesFromPoints(A, C, B, D)",
+                "Q = SecondIntersectionOfTwoCircumcircles(P, A, B, C, D)",
+                "M = MidpointOfOppositeArc(B, A, P)","N = MidpointOfOppositeArc(C, D, P)"});
+            var sampler=new ConditionalSampler(kernel.Get<IGeometryConstructor>(),configuration,new ConditionalSearchSettings());
+            Assert.That(sampler.Generic(new Random(61),8).Count,Is.EqualTo(8));
+        }
+    }
+    [TestCase("RightTriangle: A, B, C", "EqualLineSegments: A, B, A, C", "PerpendicularLines: [A, B], [A, C]")]
+    [TestCase("CyclicQuadrilateral: A, B, C, D", "EqualLineSegments: A, B, B, C", "ConcyclicPoints: A, B, C, D")]
+    public void Extending_checks_the_intrinsic_layout_constraint(string initial,string premise,string goalText)
+    {
+        var (_,_,_,kernel)=SoftSearchTest.Services();using(kernel){
+            var (configuration,names)=Parser.ParseConfiguration(new[]{initial});
+            var condition=Parser.ParseTheorem(premise,names,false);var goal=Parser.ParseTheorem(goalText,names,false);
+            var constructor=kernel.Get<IGeometryConstructor>();
+            var sampler=new ConditionalSampler(constructor,configuration,new ConditionalSearchSettings());
+            var roots=sampler.On(condition,new Random(61));var generic=sampler.Generic(new Random(19),8);
+            var extender=new ConditionalExtender(constructor);
+            var result=extender.Check(configuration,condition,goal,roots,generic,o=>names.First(n=>n.Value.Equals(o)).Key,()=>{},5000);
+            Assert.That(result.TotalVariants,Is.EqualTo(1));Assert.That(result.Status,Is.EqualTo("accepted"));
+            Assert.That(result.Variants.Single().Object,Is.EqualTo("initial-layout"));
+            Assert.That(result.Variants.Single().Status,Is.EqualTo("counterexample"));
+        }
+    }
+}

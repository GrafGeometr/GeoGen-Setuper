diff --git a/test/Regression.hs b/test/Regression.hs
new file mode 100644
index 0000000..8c0e241
--- /dev/null
+++ b/test/Regression.hs
@@ -0,0 +1,60 @@
+module Main where
+
+import Functions
+import Extending
+import Types
+import RandomGen
+import qualified Data.Map as Map
+import Data.Complex.Generic (Complex((:+)))
+import Control.Monad (unless, forM_)
+import Control.Monad.State (evalState)
+import System.Random (mkStdGen)
+
+fixed :: Rand a -> a
+fixed (Rand action) = evalState action (mkStdGen 20261112)
+
+assert :: String -> Bool -> IO ()
+assert label value = unless value (error label)
+
+point :: Shape -> Point
+point (PointShape p) = p
+point _ = error "Expected point"
+
+main :: IO ()
+main = do
+    let a = 5 :+ 12; b = 0 :+ 0; c = 14 :+ 0
+        args = map PointShape [a,b,c]
+        mid = line ((a+b)/2) ((a+c)/2)
+        cases = [("HeightMiddle",5 :+ 6), ("MedianMiddle",6 :+ 6),
+                 ("BisectorMiddle",(23/4) :+ 6), ("ExternalBisectorMiddle",(-43) :+ 6),
+                 ("SymedianMiddle",(1084/197) :+ 6), ("RadiusLineMiddle",(137/21) :+ 6)]
+    forM_ cases $ \(name,expected) -> do
+        let results = map (point . fixed) ((functions Map.! name) args)
+        assert (name ++ " exact position") (last results == expected)
+        assert (name ++ " weakened midline") (checkIncidence [PointShape (results !! 1),LineShape mid])
+        assert (name ++ " weakened defining line") (checkIncidence [PointShape (head results),LineShape (line a expected)])
+        let commands = [constPointCmd "A" a,constPointCmd "B" b,constPointCmd "C" c,
+                        Command "l" [] (const [pure (LineShape mid)]),
+                        Command "X" ["A","B","C"] (functions Map.! name)]
+        assert (name ++ " incidental fact is filtered")
+               (not (fixed (check10 commands (Conclusion ["X","l"] checkIncidence))))
+    let end = point . fixed . last $ (functions Map.! "BisectorEnd") args
+    assert "BisectorEnd is at the A-angle" (end == (13/2 :+ 0))
+    let l = line 0 2; circle2 = circle 0 2
+    assert "line incidence both orders" (checkIncidence [PointShape 1,LineShape l] && checkIncidence [LineShape l,PointShape 1])
+    assert "off-line incidence" (not (checkIncidence [PointShape (0 :+ 1),LineShape l]))
+    assert "circle incidence both orders" (checkIncidence [PointShape 2,CircleShape circle2] && checkIncidence [CircleShape circle2,PointShape 2])
+    assert "off-circle incidence" (not (checkIncidence [PointShape 1,CircleShape circle2]))
+    let get name xs = point . fixed . last $ (functions Map.! name) xs
+    assert "center" (get "CenterOfCircle" [CircleShape circle2] == 0)
+    assert "harmonic" (get "Harmonic" (map PointShape [4,0,2]) == 4/3)
+    assert "inversion" (get "InversionOfPoint" [PointShape 4,CircleShape circle2] == 1)
+    let other = circle 10 11
+    assert "negative homothety" (get "CenterOfNegativeHomothety" [CircleShape circle2,CircleShape other] == 20/3)
+    assert "positive homothety" (get "CenterOfPositiveHomothety" [CircleShape circle2,CircleShape other] == 20)
+    let circleFact = [constPointCmd "A" 0,constPointCmd "B" 2,
+                      Command "c" ["A","B"] (functions Map.! "CircleWithCenterThroughPoint")]
+    assert "defining circle incidence is filtered" (not (fixed (check10 circleFact (Conclusion ["B","c"] checkIncidence))))
+    let essential = [constPointCmd "A" 0,constPointCmd "B" 10,Command "M" ["A","B"] (functions Map.! "Midpoint")]
+    assert "essential midpoint equality survives" (fixed (check10 essential (Conclusion ["A","M","M","B"] (factCheckers Map.! "EqualLineSegments"))))
+    putStrLn "EXTENDING REGRESSION OK: six middles, angle vertex, incidence, primitives, essential theorem"

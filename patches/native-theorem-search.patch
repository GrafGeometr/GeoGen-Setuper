+using GeoGen.Core;
+using GeoGen.Constructor;
+using GeoGen.Infrastructure;
+using GeoGen.ProblemGenerator;
+using GeoGen.TheoremFinder;
+using GeoGen.Utilities;
+using Ninject;
+using NUnit.Framework;
+using static GeoGen.Core.ConfigurationObjectType;
+using static GeoGen.Core.PredefinedConstructions;
+
+namespace GeoGen.ConfigurationGenerator.Tests;
+
+[TestFixture]
+public class TheoremSearchTest
+{
+    private static (Configuration config, LooseConfigurationObject a, LooseConfigurationObject b, LooseConfigurationObject c, ConstructedConfigurationObject d) Triangle()
+    {
+        var a = new LooseConfigurationObject(Point); var b = new LooseConfigurationObject(Point); var c = new LooseConfigurationObject(Point);
+        var d = new ConstructedConfigurationObject(Midpoint, a, b);
+        return (Configuration.DeriveFromObjects(LooseObjectLayout.Triangle, a, b, c, d), a, b, c, d);
+    }
+
+    [Test]

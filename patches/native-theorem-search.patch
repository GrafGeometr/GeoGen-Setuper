+    private static (GeoGen.ProblemGenerator.ProblemGenerator generator, ITheoremFinder finder, IKernel kernel) Services()
+    {
+        var kernel=NinjectUtilities.CreateKernel();kernel.AddConstructor();
+        kernel.AddTheoremFinder(new TheoremFindingSettings(new[]{TheoremType.CollinearPoints,TheoremType.ConcyclicPoints,
+            TheoremType.PerpendicularLines,TheoremType.ParallelLines,TheoremType.EqualLineSegments},null,null));
+        kernel.AddConfigurationGenerator(new GenerationSettings(ConfigurationFilterType.MemoryEfficient));
+        var finder=kernel.Get<ITheoremFinder>();
+        return (new GeoGen.ProblemGenerator.ProblemGenerator(new ProblemGeneratorSettings(3),kernel.Get<IConfigurationGenerator>(),
+            kernel.Get<IGeometryConstructor>(),finder,new EmptyGeometryFailureTracer()),finder,kernel);
+    }
+    private static ProblemGeneratorInput Input(bool hidden=false)
+    {
+        var (_,a,b,c,_)=Triangle();var config=Configuration.DeriveFromObjects(LooseObjectLayout.Triangle,a,b,c);
+        return new ProblemGeneratorInput(config,new Construction[]{Midpoint,ComposedConstructions.Orthocenter}.ToReadOnlyHashSet(),2,
+            new Dictionary<ConfigurationObjectType,int>{{Point,2},{Line,0},{Circle,0}},SymmetryGenerationMode.GenerateBothSymmetricAndAsymmetric,
+            hidden?new[]{c}:Array.Empty<ConfigurationObject>());
+    }
+    [Test]
+    public void Native_search_reuses_the_same_theorems_as_full_finder_and_respects_limits()
+    {
+        var (generator,finder,kernel)=Services();using(kernel)
+        {
+            var input=Input();var policy=new TheoremSearchSettings { Seconds=10,MaxEvaluated=30,Proposals=12,Keep=3,RequireNonLocalTheorem=false };
+            var outputs=generator.GenerateTheoremSearch(input,policy).generationOutputs.ToArray();
+            Assert.That(outputs,Is.Not.Empty);
+            foreach(var output in outputs)
+            {
+                Assert.That(output.Configuration.IterationIndex,Is.LessThanOrEqualTo(2));
+                var incremental=output.OldTheorems.AllObjects.Concat(output.NewTheorems.AllObjects).ToHashSet();
+                Assert.That(incremental.SetEquals(finder.FindAllTheorems(output.ContextualPicture).AllObjects),Is.True);
+            }
+            Assert.That(outputs.Select(o=>o.OldTheorems.AllObjects.Count+o.NewTheorems.AllObjects.Count).Distinct().Count(),Is.GreaterThan(1));
+        }
+    }

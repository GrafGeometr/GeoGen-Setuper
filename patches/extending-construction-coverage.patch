+poncelet :: Point -> Point -> Point -> Point -> Point
+poncelet a b c d =
+    let ab = (a+b)/2
+    in ccintersect ab (circumcircle ab ((b+c)/2) ((c+a)/2))
+                      (circumcircle ab ((a+d)/2) ((b+d)/2))
